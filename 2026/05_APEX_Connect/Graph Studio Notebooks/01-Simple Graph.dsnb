      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 0,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql",
          "",
          "CREATE PROPERTY GRAPH IF NOT EXISTS simple_graph",
          "    VERTEX TABLES(",
          "        products",
          "            KEY(ID)",
          "            LABEL product",
          "            PROPERTIES ARE ALL COLUMNS,",
          "        customers",
          "            KEY(ID)",
          "            LABEL customer",
          "            PROPERTIES ARE ALL COLUMNS",
          "    )",
          "    EDGE TABLES(",
          "        buys",
          "            KEY(ID)",
          "            SOURCE KEY (cust) REFERENCES customers (id) ",
          "            DESTINATION KEY (prod) REFERENCES products (id)",
          "            LABEL buys",
          "            NO PROPERTIES ",
          ")"
        ],
        "selectedVisualization" : "raw",
        "visualizationConfig" : null,
        "hideCode" : false,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
        "enabled" : true,
        "forms" : "[]",
        "result" : null,
        "relations" : [ ],
        "dynamicFormParams" : null
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 0,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql",
          "",
          "SELECT *",
          "FROM GRAPH_TABLE (",
          "  simple_graph",
          "  MATCH (c IS customer)-[e IS buys]->(p IS product)",
          "  COLUMNS (",
          "    c.name AS customer_name,",
          "    p.name AS product_name,",
          "    vertex_id(c) AS c_node_id,",
          "    vertex_id(p) AS p_node_id,",
          "    edge_id(e) AS e_edge_id",
          "  )",
          ")"
        ],
        "selectedVisualization" : "visualization",
        "visualizationConfig" : "[{\"visualization\":{\"height\":500,\"ruleBasedStyles\":[{\"stylingEnabled\":true,\"visibilityEnabled\":true,\"aggregationEnabled\":true,\"modifierStyles\":{},\"style\":{\"dasharray\":\"5\",\"color\":\"rgba(0, 0, 0, 0.1)\"},\"properties\":{\"style\":[\"dashed\"]},\"_id\":1583324064459,\"target\":\"edge\",\"type\":\"styling\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"hiddenConnection\",\"operator\":\"*\",\"value\":\"\"}]},\"component\":\"edge\",\"legendTitle\":\"Hidden Connection\",\"_fromTemplate\":true},{\"_id\":\"-3c1f9907\",\"visibilityEnabled\":true,\"stylingEnabled\":true,\"aggregationEnabled\":true,\"modifierStyles\":{},\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"CUSTOMER\"}]},\"properties\":{\"color\":\"#8FBFD0\",\"label\":{\"text\":\"${properties['NAME']}\"}},\"aggregation\":[],\"style\":{\"color\":\"#8FBFD0\",\"label\":{\"text\":\"${properties['NAME']}\"}},\"component\":\"vertex\",\"type\":\"styling\",\"target\":\"vertex\",\"isDefaultRule\":true,\"legendTitle\":\"CUSTOMER\"},{\"_id\":\"3916fd28\",\"visibilityEnabled\":true,\"stylingEnabled\":true,\"aggregationEnabled\":true,\"modifierStyles\":{},\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"PRODUCT\"}]},\"properties\":{\"color\":\"#F0CC71\",\"label\":{\"text\":\"${properties['NAME']}\"}},\"aggregation\":[],\"style\":{\"color\":\"#F0CC71\",\"label\":{\"text\":\"${properties['NAME']}\"}},\"component\":\"vertex\",\"type\":\"styling\",\"target\":\"vertex\",\"isDefaultRule\":true,\"legendTitle\":\"PRODUCT\"},{\"_id\":\"-5b575d5d\",\"visibilityEnabled\":true,\"stylingEnabled\":true,\"aggregationEnabled\":true,\"modifierStyles\":{},\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"BUYS\"}]},\"properties\":{\"color\":\"#8B8580\",\"label\":{\"text\":\"$