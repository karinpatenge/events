      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 0,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql",
          "",
          "SELECT *",
          "FROM GRAPH_TABLE (",
          "  bom_graph",
          "  MATCH (n)-[e]->(m)-[f]->(o)",
          "  COLUMNS (",
          "    vertex_id(n) AS n_node_id,",
          "    edge_id(e) AS e_edge_id,",
          "    vertex_id(m) AS m_node_id,",
          "    edge_id(f) AS f_edge_id,",
          "    vertex_id(o) AS o_node_id    ",
          "  )",
          ")",
          "OFFSET 40000 ROWS FETCH NEXT 100 ROWS ONLY"
        ],
