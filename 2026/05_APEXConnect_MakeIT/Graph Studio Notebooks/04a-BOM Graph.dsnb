        "message" : [
          "%sql",
          "",
          "SELECT *",
          "FROM GRAPH_TABLE (",
          "  bom_graph",
          "  MATCH (n)-[e]->{3,4}(m)",
          "  ONE ROW PER STEP (v1, k, v2)",
          "  COLUMNS (",
          "    vertex_id(v1) AS v1_node_id,",
          "    edge_id(k) AS k_edge_id,",
          "    vertex_id(v2) AS v2_node_id   ",
          "  )",
          ")",
          "OFFSET 10000 ROWS FETCH NEXT 50 ROWS ONLY"
        ],
