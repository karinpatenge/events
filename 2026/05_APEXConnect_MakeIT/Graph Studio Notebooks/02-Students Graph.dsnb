      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql",
          "",
          "DROP PROPERTY GRAPH IF EXISTS students_graph_weighted"
        ],
        "selectedVisualization" : "raw",
        "visualizationConfig" : null,
        "hideCode" : false,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
        "enabled" : true,
        "forms" : "[]",
        "result" : null,
        "relations" : [ ],
        "dynamicFormParams" : null
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql",
          "",
          "CREATE PROPERTY GRAPH IF NOT EXISTS students_graph_weighted",
          "    VERTEX TABLES (",
          "        persons",
          "            KEY (person_id)",
          "            LABEL person PROPERTIES (person_id, name, birthdate AS dob, hr_data AS hr_info)",
          "            LABEL person_ht PROPERTIES (height),",
          "        universities",
          "            KEY (university_id)",
          "            LABEL university",
          "            PROPERTIES (university_id, name),",
          "        subjects",
          "            KEY (subject_id)",
          "            LABEL subject PROPERTIES (subject_id, name)",
          "    )",
          "    EDGE TABLES (",
          "        friends AS is_friend_of",
          "            KEY (friendship_id)",
          "            SOURCE KEY (person_a_id) REFERENCES persons (person_id)",
          "            DESTINATION KEY (person_b_id) REFERENCES persons (person_id)",
          "            LABEL is_friend_of PROPERTIES (friendship_id, meeting_date, weight),  -- Weight added as new property",
          "        student_of AS studied_at",
          "            KEY (student_id)",
          "            SOURCE KEY (person_id) REFERENCES persons (person_id)",
          "            DESTINATION KEY (university_id) REFERENCES universities (university_id)",
          "            LABEL studied_at NO PROPERTIES,",
          "        student_of AS studied",
          "            KEY (student_id)",
          "            SOURCE KEY (person_id) REFERENCES persons (person_id)",
          "            DESTINATION KEY (subject_id) REFERENCES subjects (subject_id)",
          "            LABEL studied NO PROPERTIES",
          "    )"
        ],
        "selectedVisualization" : "raw",
        "visualizationConfig" : null,
        "hideCode" : false,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
        "enabled" : true,
        "forms" : "[]",
        "result" : null,
        "relations" : [ ],
        "dynamicFormParams" : null
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 6,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql",
          "",
          "-- Run BELLMAN-FORD on the weighted graph starting from vertex \"Tom\"",
          "SELECT *",
          "FROM GRAPH_TABLE (",
          "    DBMS_OGA.BELLMAN_FORD (",
          "        students_graph_weighted,",
          "        JSON (",
          "            '{",
          "                \"GRAPH_OWNER\" : \"AC2026\",",
          "                \"GRAPH_NAME\"  : \"STUDENTS_GRAPH_WEIGHTED\",",
          "                \"ELEM_TABLE\"  : \"PERSONS\",",
          "                \"KEY_VALUE\"   : {\"PERSON_ID\" : 3}",
          "            }'",
          "        ),",
          "        PROPERTY(EDGE INPUT weight DEFAULT ON NULL 0),",
          "        PROPERTY(VERTEX OUTPUT distance)",
          "    )",
          "    MATCH (a IS person)",
          "    COLUMNS (",
          "        a.name, ",
          "        a.distance",
          "    )",
          ")",
          "ORDER BY distance, name ASC"
        ],
        "selectedVisualization" : "table",
