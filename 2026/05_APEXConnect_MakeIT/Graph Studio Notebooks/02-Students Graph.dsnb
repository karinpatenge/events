        "message" : [
          "%sql",
          "",
          "CREATE TABLE IF NOT EXISTS student_of (",
          "    student_id NUMBER GENERATED ALWAYS AS IDENTITY (START WITH 1 INCREMENT BY 1),",
          "    university_id NUMBER,",
          "    person_id NUMBER,",
          "    subject_id NUMBER,",
          "    CONSTRAINT student_of_pk PRIMARY KEY (student_id),",
          "    CONSTRAINT student_of_person_fk FOREIGN KEY (person_id) REFERENCES persons(person_id),",
          "    CONSTRAINT student_of_university_pk FOREIGN KEY (university_id) REFERENCES universities (university_id),",
          "    CONSTRAINT student_of_subject_pk FOREIGN KEY (subject_id) REFERENCES subjects (subject_id)",
          ");"
        ],
