        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%md",
          "",
          "## Create the Students Graph",
          "",
          "Additional documentation:",
          "",
          "- [SQL Language Reference 26](https://docs.oracle.com/en/database/oracle/oracle-database/26/sqlrf/create-property-graph.html#GUID-37364ADB-E89C-4D92-A431-F2544FEDB218)"
        ],
        "selectedVisualization" : "html",
        "visualizationConfig" : null,
        "hideCode" : true,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
        "enabled" : true,
        "forms" : "[]",
        "result" : null,
        "relations" : [ ],
        "dynamicFormParams" : null
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql",
          "",
          "CREATE PROPERTY GRAPH IF NOT EXISTS students_graph",
          "    VERTEX TABLES (",
          "        persons",
          "            KEY (person_id)",
          "            LABEL person PROPERTIES (person_id, name, birthdate AS dob, hr_data AS hr_info)",
          "            LABEL person_ht PROPERTIES (height),",
          "        universities",
          "            KEY (university_id)",
          "            LABEL university",
          "            PROPERTIES (university_id, name),",
          "        subjects",
          "            KEY (subject_id)",
          "            LABEL subject PROPERTIES (subject_id, name)",
          "    )",
          "    EDGE TABLES (",
          "        friends AS is_friend_of",
          "            KEY (friendship_id)",
          "            SOURCE KEY (person_a_id) REFERENCES persons (person_id)",
          "            DESTINATION KEY (person_b_id) REFERENCES persons (person_id)",
          "            LABEL is_friend_of PROPERTIES (friendship_id, meeting_date),",
          "        student_of AS studied_at",
          "            KEY (student_id)",
          "            SOURCE KEY (person_id) REFERENCES persons (person_id)",
          "            DESTINATION KEY (university_id) REFERENCES universities (university_id)",
          "            LABEL studied_at NO PROPERTIES,",
          "        student_of AS studied",
          "            KEY (student_id)",
          "            SOURCE KEY (person_id) REFERENCES persons (person_id)",
          "            DESTINATION KEY (subject_id) REFERENCES subjects (subject_id)",
          "            LABEL studied NO PROPERTIES",
          "    )"
        ],
        "selectedVisualization" : "raw",
        "visualizationConfig" : null,
        "hideCode" : false,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
        "enabled" : true,
        "forms" : "[]",
        "result" : null,
        "relations" : [ ],
        "dynamicFormParams" : null
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%md",
          "",
          "## Query the Students Graph using SQL/PGQ",
          "",
          "Additional documentation:",
          "",
          "- [Graph Developer´s Guide for Property Graph 26.2 - SQL Graph Queries](https://docs.oracle.com/en/database/oracle/property-graph/26.2/spgdg/sql-graph-queries.html)"
        ],
        "selectedVisualization" : "html",
        "visualizationConfig" : null,
        "hideCode" : true,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
        "enabled" : true,
        "forms" : "[]",
        "result" : null,
        "relations" : [ ],
        "dynamicFormParams" : null
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql",
          "",
          "-- Querying the full graph",
          "SELECT *",
          "FROM",
          "    GRAPH_TABLE (",
          "        students_graph",
          "        MATCH (v1)-[e]->(v2)",
          "        COLUMNS (",
          "            VERTEX_ID(v1) AS v1_node_id,",
          "            EDGE_ID(e) AS e_edge_id,",
          "            VERTEX_ID(v2) AS v2_node_id",
          "    )",
          ")"
        ],
