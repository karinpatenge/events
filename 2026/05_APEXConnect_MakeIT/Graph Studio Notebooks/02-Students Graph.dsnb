']}\"}},\"component\":\"vertex\",\"type\":\"styling\",\"target\":\"vertex\",\"isDefaultRule\":true,\"legendTitle\":\"PERSON, PERSON_HT\"}],\"displaySizeOnLoad\":14,\"charLimit\":50,\"lastColumns\":[\"PERSON_NAME\",\"P1_NODE_ID\",\"F_EDGE_ID\",\"P2_NODE_ID\",\"E_EDGE_ID\",\"V_NODE_ID\"],\"version\":11}}]",
