        "message" : [
          "%sql",
          "",
          "-- Use the PROPERTY_EXISTS predicate to determine if the graph element bound to a singleton element reference has a specific property.",
          "SELECT *",
          "FROM",
          "    GRAPH_TABLE (",
          "        students_graph",
          "        MATCH (n)",
          "        COLUMNS (",
          "            n.name, ",
          "            PROPERTY_EXISTS(n, name) AS nameExists",
          "        )",
          "    );"
        ],
