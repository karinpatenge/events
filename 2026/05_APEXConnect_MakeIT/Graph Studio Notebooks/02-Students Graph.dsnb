      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql",
          "",
          "SELECT",
          "    comp_id,",
          "    LISTAGG(name, ', ') WITHIN GROUP (ORDER BY name) AS members_in_component",
          "FROM GRAPH_TABLE (",
          "    DBMS_OGA.WCC (",
          "        students_graph,",
          "        PROPERTY(VERTEX OUTPUT comp_id))",
          "        MATCH (a IS Person)",
          "        COLUMNS (",
          "            a.name AS name,",
          "            a.comp_id AS comp_id",
          "        )",
          "    )",
          "GROUP BY comp_id",
          "ORDER BY comp_id"
        ],
        "selectedVisualization" : "table",
        "visualizationConfig" : "[{\"table\":{\"numberOfItems\":10,\"lastColumns\":[\"NAME\",\"COMP_ID\"],\"version\":1}}]",
