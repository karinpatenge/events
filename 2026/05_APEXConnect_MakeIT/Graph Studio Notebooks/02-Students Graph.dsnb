      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 6,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql",
          "",
          "-- Show all persons in the graph to compare with the results of BELLMAN-FORD",
          "SELECT *",
          "FROM",
          "    GRAPH_TABLE (",
          "        students_graph_weighted",
          "        MATCH",
          "            (v1 IS Person)-[e]->(v2 IS Person),",
          "            (v3 IS Person)",
          "        WHERE",
          "            NOT VERTEX_EQUAL(v1,v3) AND",
          "            NOT VERTEX_EQUAL(v2,v3)",
          "        COLUMNS (",
          "            VERTEX_ID(v1) AS v1_node_id,",
          "            EDGE_ID(e) AS e_edge_id,",
          "            VERTEX_ID(v2) AS v2_node_id,",
          "            VERTEX_ID(v3) AS v3_node_id",
          "        )",
          "    )"
        ],
