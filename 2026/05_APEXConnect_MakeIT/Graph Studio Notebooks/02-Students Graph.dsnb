          "%sql",
          "",
          "-- Add some sample data that are weakly connected.",
          "BEGIN",
          "    INSERT INTO persons (name )",
          "        VALUES",
          "            ('Bero'),",
          "            ('Ana'),",
          "            ('Matej');",
          "    INSERT INTO universities (name) VALUES ('University of Maribor');",
          "    INSERT INTO student_of (university_id, person_id, subject_id) VALUES (4, 7, NULL);",
          "    INSERT INTO friends (person_a_id, person_b_id) VALUES (8, 9);",
          "    COMMIT;",
          "END;"
        ],
