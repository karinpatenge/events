      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%md",
          "",
          "### PageRank",
          "",
          "The PAGERANK algorithm computes, for every vertex in the graph, a measure of how important this vertex is in the graph.  ",
          "The measure of importance is based on the number of incoming neighbors for the vertex, as well as how important are these neighbors."
        ],
        "selectedVisualization" : "html",
        "visualizationConfig" : null,
        "hideCode" : true,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
        "enabled" : true,
        "forms" : "[]",
        "result" : null,
        "relations" : [ ],
        "dynamicFormParams" : null
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql",
          "",
          "-- Compute PageRank for vertices labeled \"Person\". Return the value as a new property named \"rank\".",
          "SELECT *",
          "FROM GRAPH_TABLE(",
          "    DBMS_OGA.PAGERANK (",
          "        students_graph,",
          "        PROPERTY (VERTEX OUTPUT rank),",
          "        10, 1.0, 0.85d, FALSE",
          "    )",
          "    MATCH (v IS Person)",
          "    COLUMNS (",
          "        v.name,",
          "        v.rank",
          "  )",
          ") ",
          "ORDER BY rank DESC"
        ],
        "selectedVisualization" : "table",
        "visualizationConfig" : "[{\"visualization\":{\"ruleBasedStyles\":[{\"stylingEnabled\":true,\"visibilityEnabled\":true,\"aggregationEnabled\":true,\"modifierStyles\":{},\"style\":{\"dasharray\":\"5\",\"color\":\"rgba(0, 0, 0, 0.1)\"},\"properties\":{\"style\":[\"dashed\"]},\"_id\":1583324064459,\"target\":\"edge\",\"type\":\"styling\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"hiddenConnection\",\"operator\":\"*\",\"value\":\"\"}]},\"component\":\"edge\",\"legendTitle\":\"Hidden Connection\",\"_fromTemplate\":true},{\"_id\":\"-1d848516\",\"visibilityEnabled\":true,\"stylingEnabled\":true,\"aggregationEnabled\":true,\"modifierStyles\":{},\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"PERSON\"},{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"PERSON_HT\"}]},\"properties\":{\"icon\":{\"class\":\"fa-user\",\"color\":\"white\"},\"color\":\"blue\",\"label\":{\"text\":\"${properties['NAME']}\"}},\"aggregation\":[],\"style\":{\"icon\":{\"class\":\"fa-user\",\"color\":\"white\"},\"color\":\"blue\",\"label\":{\"text\":\"${properties['NAME']}\"}},\"component\":\"vertex\",\"type\":\"styling\",\"target\":\"vertex\",\"isDefaultRule\":true,\"legendTitle\":\"PERSON, PERSON_HT\"}],\"displaySizeOnLoad\":6,\"lastColumns\":[\"VERTEX_ID\",\"NAME\",\"RANK\"],\"version\":11,\"vertexPositions\":[]},\"table\":{\"numberOfItems\":6,\"lastColumns\":[\"NAME\",\"RANK\"],\"version\":1}}]",
        "hideCode" : false,
