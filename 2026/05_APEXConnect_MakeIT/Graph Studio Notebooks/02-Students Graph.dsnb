      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql",
          "",
          "-- Find friends of Matti and the universities they attended",
          "SELECT DISTINCT *",
          "FROM",
          "    GRAPH_TABLE (",
          "        students_graph",
          "        MATCH",
          "            path1 = (p1 IS person) -[IS is_friend_of]-{2} (p2 IS person),",
          "            path2 = (p2) -[IS studied_at]-> (u2 IS university)",
          "        WHERE",
          "            p1.name = 'Matti' AND",
          "            p1.name <> p2.name",
          "        ONE ROW PER VERTEX (v)",
          "        COLUMNS (",
          "            p2.name AS name,",
          "            u2.name AS university",
          "        )",
          "    )",
          "ORDER BY name, university"
        ],
