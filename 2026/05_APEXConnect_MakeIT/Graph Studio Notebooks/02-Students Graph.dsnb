        "message" : [
          "%md",
          "",
          "## Run Graph Algorithm Functions in SQL/PGQ Queries",
          "",
          "Using the **DBMS_OGA** package",
          "",
          "Note: The PL/SQL package is available as of version **26.2**."
        ],
        "selectedVisualization" : "html",
        "visualizationConfig" : null,
        "hideCode" : true,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
        "enabled" : true,
        "forms" : "[]",
        "result" : null,
