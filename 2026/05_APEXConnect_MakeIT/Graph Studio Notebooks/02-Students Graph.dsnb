      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql",
          "",
          "-- Query using IN Path Clause and ONE ROW PER VERTEX",
          "SELECT *",
          "FROM",
          "    GRAPH_TABLE ( ",
          "        students_graph",
          "        MATCH",
          "            path1 = (u IS university) <-[IS studied_at]- (p1 IS person),",
          "            path2 = (p1) -[IS is_friend_of]-{1,2} (p2 IS person),         -- undirected",
          "            path3 = (p2) -[IS studied]-> (s IS subject)",
          "        WHERE",
          "            u.name = 'University of Hannover' AND ",
          "            s.name = 'Mathematics'",
          "        ONE ROW PER VERTEX (v) IN (path2)",
          "        COLUMNS (",
          "            MATCHNUM() AS matchnum,",
          "            PATH_NAME() AS path_name,",
          "            ELEMENT_NUMBER(v) AS element_number,",
          "            v.*",
          "        )",
          "    )",
          "ORDER BY",
          "    matchnum,",
          "    element_number"
        ],
        "selectedVisualization" : "table",
