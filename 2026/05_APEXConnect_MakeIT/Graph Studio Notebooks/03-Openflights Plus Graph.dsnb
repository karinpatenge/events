        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql",
          "",
          "-- Show the connections from Ljubljana (LJU) to other airports with 1 or 2 stopovers having flight segment distances between 1000 and 2000.",
          "SELECT DISTINCT *",
          "FROM GRAPH_TABLE (",
          "  openflights_plus_graph",
          "  MATCH (a IS airport) -[r IS route]->{1,2} (d IS airport)",
          "  WHERE a.iata='LJU'",
          "  ONE ROW PER STEP (v1, k, v2)",
          "  COLUMNS (",
          "    v1.iata AS iata1,",
          "    v2.iata AS iata2,",
          "    k.distance AS distance,",
          "    k.airline AS airline",
          "  )",
          ")",
          "WHERE",
          "  distance > 1000 AND distance < 2000",
          "ORDER BY",
          "  iata1,",
          "  iata2,",
          "  distance"
        ],
        "selectedVisualization" : "table",
        "visualizationConfig" : null,
        "hideCode" : false,
