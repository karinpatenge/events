        "hasTitle" : false,
        "message" : [
          "%sql",
          "",
          "-- Which airports are located in Berlin, Germany?",
          "SELECT *",
          "FROM GRAPH_TABLE (",
          "  openflights_plus_graph",
          "  MATCH (a IS airport) -[e]-> (c IS city)",
          "  WHERE c.city='Berlin' AND c.country='Germany'",
          "  COLUMNS (",
          "    vertex_id(a) AS airport,",
          "    edge_id(e) AS located_in,",
          "    vertex_id(c) AS city,",
          "    a.iata,",
          "    a.name",
          "  )",
          ")"
        ],
