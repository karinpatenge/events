      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql",
          "",
          "-- Show the entire graph",
          "SELECT *",
          "FROM GRAPH_TABLE (",
          "  openflights_plus_graph",
          "  MATCH (v1) -[e1]-> (v2) -[e2 IS located_in]-> (v3)",
          "  COLUMNS (",
          "    vertex_id(v1) AS src,",
          "    edge_id(e1) AS route,",
          "    vertex_id(v2) AS dst,",
          "    edge_id(e2) AS located_in,",
          "    vertex_id(v3) AS city)",
          ")",
          "FETCH FIRST 1000 ROWS ONLY"
        ],
        "selectedVisualization" : "visualization",
