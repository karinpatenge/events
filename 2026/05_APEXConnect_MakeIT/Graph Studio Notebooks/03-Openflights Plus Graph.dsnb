        "message" : [
          "%sql",
          "",
          "-- Show all flights from Ljubljana (LJU) to Berlin (TXL) with 1 up to 3 flight segments",
          "SELECT *",
          "FROM GRAPH_TABLE (",
          "  openflights_plus_graph",
          "  MATCH (a IS airport WHERE a.iata='LJU') -[r IS route]-> {1,3}(d IS airport WHERE d.iata='TXL')",
          "  ONE ROW PER STEP (v1, e, v2)",
          "  COLUMNS (",
          "    vertex_id(v1) AS src,",
          "    edge_id(e) AS route,",
          "    e.airline AS airline,",
          "    vertex_id(v2) AS dst",
          "  )",
          ")",
          "ORDER BY airline"
        ],
        "selectedVisualization" : "visualization",
        "visualizationConfig" : "[{\"visualization\":{\"ruleBasedStyles\":[{\"stylingEnabled\":true,\"visibilityEnabled\":true,\"aggregationEnabled\":true,\"modifierStyles\":{},\"style\":{\"dasharray\":\"5\",\"color\":\"rgba(0, 0, 0, 0.1)\"},\"properties\":{\"style\":[\"dashed\"]},\"_id\":1583324064459,\"target\":\"edge\",\"type\":\"styling\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"hiddenConnection\",\"operator\":\"*\",\"value\":\"\"}]},\"component\":\"edge\",\"legendTitle\":\"Hidden Connection\",\"_fromTemplate\":true},{\"_id\":\"37ce84cc\",\"stylingEnabled\":true,\"visibilityEnabled\":true,\"target\":\"vertex\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"AIRPORT\"}]},\"component\":\"vertex\",\"style\":{\"color\":\"#8FBFD0\"},\"legendTitle\":\"AIRPORT\",\"isDefaultRule\":true},{\"_id\":\"17860fa7\",\"stylingEnabled\":true,\"visibilityEnabled\":true,\"target\":\"edge\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"ROUTE\"}]},\"component\":\"edge\",\"style\":{\"color\":\"#8B8580\"},\"legendTitle\":\"ROUTE\",\"isDefaultRule\":true}],\"version\":11}}]",
