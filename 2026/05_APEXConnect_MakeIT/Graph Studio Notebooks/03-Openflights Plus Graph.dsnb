{\"color\":\"#8B8580\"},\"legendTitle\":\"IS_FRIEND_OF\",\"isDefaultRule\":true},{\"_id\":\"-44a72908\",\"stylingEnabled\":true,\"visibilityEnabled\":true,\"target\":\"edge\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"STUDIED\"}]},\"component\":\"edge\",\"style\":{\"color\":\"#8B8580\"},\"legendTitle\":\"STUDIED\",\"isDefaultRule\":true},{\"_id\":\"-f46bd2a\",\"stylingEnabled\":true,\"visibilityEnabled\":true,\"target\":\"edge\",\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"STUDIED_AT\"}]},\"component\":\"edge\",\"style\":{\"color\":\"#8B8580\"},\"legendTitle\":\"STUDIED_AT\",\"isDefaultRule\":true},{\"_id\":\"-1d848516\",\"visibilityEnabled\":true,\"stylingEnabled\":true,\"aggregationEnabled\":true,\"modifierStyles\":{},\"conditions\":{\"operator\":\"and\",\"conditions\":[{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"PERSON\"},{\"property\":\"labels\",\"operator\":\"CONTAINS\",\"value\":\"PERSON_HT\"}]},\"properties\":{\"icon\":{\"class\":\"fa-user\",\"color\":\"white\"},\"color\":\"blue\",\"label\":{\"text\":\"${properties['NAME']}\"}},\"aggregation\":[],\"style\":{\"icon\":{\"class\":\"fa-user\",\"color\":\"white\"},\"color\":\"blue\",\"label\":{\"text\":\"${properties['NAME']}\"}},\"component\":\"vertex\",\"type\":\"styling\",\"target\":\"vertex\",\"isDefaultRule\":true,\"legendTitle\":\"PERSON, PERSON_HT\"}],\"displaySizeOnLoad\":27,\"charLimit\":50,\"lastColumns\":[\"SRC\",\"ROUTE\",\"DST\",\"LOCATED_IN\",\"CITY\"],\"version\":11}}]",
