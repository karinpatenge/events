          "%python",
          "",
          "EPS_METRES  = 50",
          "MIN_SAMPLES = 12",
          "",
          "# Die Radunfälle einmal lesen, in Metern und in fester Reihenfolge (nach ID),",
          "# damit die Cluster-Kennzeichnungen später zu den Zeilen passen",
          "bike_m = bike_sdf.to_crs(CRS_METRIC).as_geodataframe().sort_values('ID').reset_index(drop=True)",
          "X = SpatialDataFrame.create(GeoDataFrameDataset(bike_m[['geometry']]))",
          "coords = SCoordTransformer().transform(X)        # Geometrie -> x/y-Merkmale",
          "",
          "dbscan = DBScanClustering(eps=EPS_METRES, min_samples=MIN_SAMPLES)",
          "labels = dbscan.fit_predict(coords)",
          "",
          "n_clusters = len(set(labels)) - (1 if -1 in labels else 0)",
          "print(f'Clusters: {n_clusters}')",
          "print(f'Accidents in clusters: {(labels >= 0).sum():,} of {len(labels):,} ({(labels >= 0).mean():.0%})')"
        ],
