        "message": [
          "%sql",
          "",
          "SELECT COUNT(*)                                   AS grid_cells,",
          "       SUM(population)                            AS residents,",
          "       SUM(under_18)                              AS under_18,",
          "       SUM(age_18_29)                             AS age_18_29,",
