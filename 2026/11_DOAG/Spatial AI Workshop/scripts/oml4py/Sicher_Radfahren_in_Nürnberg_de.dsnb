          "edu_m['IN_HOTSPOT'] = (edu_m['LABEL'] == 'HOTSPOT').astype(int)",
          "",
          "print(f'Hotspot hexagons: {(grid[\"QUADRANT\"] == 1).mean():.0%} of all hexagons\\n')",
          "for kind, g in edu_m.groupby('KIND'):",
          "    print(f'{kind:<13} {len(g):>4} places, {g[\"IN_HOTSPOT\"].sum():>4} in a hotspot hexagon ({g[\"IN_HOTSPOT\"].mean():.0%})')"
        ],
