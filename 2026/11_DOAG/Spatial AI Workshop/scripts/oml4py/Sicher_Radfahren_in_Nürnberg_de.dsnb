        "hasTitle": true,
        "message": [
          "%sql",
          "",
          "SELECT CASE accident_type",
          "         WHEN 1 THEN '1 Driving accident (loss of control)'",
          "         WHEN 2 THEN '2 Turning'",
          "         WHEN 3 THEN '3 Turning into a road or crossing'",
          "         WHEN 4 THEN '4 Pedestrian crossing the road'",
          "         WHEN 5 THEN '5 Stationary traffic (parking)'",
          "         WHEN 6 THEN '6 Moving along in the same lane'",
          "         ELSE        '7 Other'",
          "       END                                      AS type_of_accident,",
          "       COUNT(*)                                 AS accidents,",
          "       SUM(CASE WHEN category <= 2 THEN 1 ELSE 0 END) AS killed_or_serious",
          "FROM   nue_accidents",
          "WHERE  is_bicycle = 1",
          "GROUP  BY accident_type",
          "ORDER  BY accident_type"
        ],
        "selectedVisualization": "table",
