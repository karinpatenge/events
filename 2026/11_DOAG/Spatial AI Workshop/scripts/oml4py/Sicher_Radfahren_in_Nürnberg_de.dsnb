          "edu_m = SpatialDataFrame.create(DBSpatialDataset(table=T_EDU)).to_crs(CRS_METRIC).as_geodataframe()",
          "edu_m = gpd.sjoin(edu_m, grid[['LABEL', 'geometry']], predicate='within', how='left').drop(columns='index_right')",
          "edu_m = edu_m[~edu_m.index.duplicated()]                 # ein Punkt auf der Grenze zweier Hexagone",
