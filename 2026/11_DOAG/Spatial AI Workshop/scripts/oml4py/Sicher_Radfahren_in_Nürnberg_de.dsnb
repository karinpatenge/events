        "message": [
          "%md",
          "",
          "###### Workshop-Parameter",
          "",
          "* `PAR_URL` – Pre-Authenticated Request (PAR) für den Workshop-Bucket in OCI Object Storage. **Ersetzen Sie den Platzhalter durch die URL der Workshop-Leitenden.** Sie endet mit `/o/`.",
          "* `ACCIDENT_FILES` – eine Unfallatlas-Datei pro Jahr, genau wie veröffentlicht. Jede Datei umfasst ganz Deutschland (etwa 270.000 Unfälle). Weniger Jahre laden schneller.",
          "* `CENSUS_FILE`, `EDU_FILE` – das Zensus-2022-Gitter mit den Einwohnern nach Altersklassen, zugeschnitten auf Bayern, sowie die Schulen, Kindergärten, Universitäten und Studentenwohnheime aus OpenStreetMap.",
          "* `REGION_AGS` – Amtlicher Gemeindeschlüssel (AGS). `09564000` ist die Stadt Nürnberg.",
          "* `CRS_METRIC` – ETRS89 / UTM-Zone 32N (EPSG:25832), das amtliche projizierte Koordinatensystem in Bayern. Entfernungen sind in Metern. Clustering und räumliche Gewichte brauchen projizierte Koordinaten."
        ],
        "selectedVisualization": "html",
        "visualizationConfig": null,
        "hideCode": true,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": true,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
        "result": null,
        "relations": [],
        "dynamicFormParams": null
      },
      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": "Workshop-Parameter setzen",
        "hasTitle": true,
        "message": [
          "%python",
          "",
          "# ---- Object Storage (von den Workshop-Leitenden) ---------------------------------",
          "PAR_URL     = 'https://objectstorage.<region>.oraclecloud.com/p/<token>/n/<namespace>/b/<bucket>/o/'",
          "DATA_PREFIX = ''          # Ordner im Bucket, z. B. 'data/' - leer, wenn die Dateien auf oberster Ebene liegen",
          "",
          "# ---- Quelldateien (Unfallatlas, eine pro Jahr; 2021 als .txt veröffentlicht) --",
          "ACCIDENT_FILES = {",
          "    2020: 'Unfallorte2020_LinRef.csv',",
          "    2021: 'Unfallorte2021_LinRef.txt',",
          "    2022: 'Unfallorte2022_LinRef.csv',",
          "    2023: 'Unfallorte2023_LinRef.csv',",
          "    2024: 'Unfallorte2024_LinRef.csv',",
          "    2025: 'Unfallorte2025_LinRef.csv',",
          "}",
          "INFRA_FILE  = 'nuremberg_bicycle_infrastructure.geojson'",
          "CENSUS_FILE = 'Zensus2022_Alter_in_5_Altersklassen_100m-Gitter_Bayern.csv'   # bayerischer Teil, etwa 37 MB",
          "EDU_FILE    = 'nuremberg_housing_data.geojson'                         # Schulen, Kindergärten, Hochschulen, Studentenwohnheime",
          "",
          "# ---- Region und Koordinatensysteme ----------------------------------------",
          "REGION_AGS = '09564000'    # Nürnberg (Stadt)",
          "CRS_SOURCE = 'EPSG:25832'  # Koordinaten in den Unfallatlas-Dateien (LINREFX, LINREFY)",
          "CRS_METRIC = 'EPSG:25832'  # für Entfernungen in Metern",
          "CRS_STORE  = 'EPSG:4326'   # WGS84 Längen-/Breitengrad, so in der Datenbank gespeichert",
          "CRS_CENSUS = 'EPSG:3035'   # ETRS89 / LAEA Europe, Koordinatensystem des Zensus-Gitters",
          "",
          "# ---- Von diesem Notebook angelegte Tabellen (bei jedem Lauf ersetzt) ----------",
          "T_ACCIDENTS = 'NUE_ACCIDENTS'",
          "T_INFRA     = 'NUE_BIKE_INFRA'",
          "T_CENSUS    = 'NUE_CENSUS_GRID'",
          "T_EDU       = 'NUE_EDUCATION'",
          "T_EDU_RISK  = 'NUE_EDUCATION_SURROUNDINGS'",
          "T_CLUSTERS  = 'NUE_BIKE_ACCIDENT_CLUSTERS'",
          "T_GRID      = 'NUE_HOTSPOT_GRID'",
          "T_SUMMARY   = 'NUE_CLUSTER_SUMMARY'",
          "",
          "if '<token>' in PAR_URL:",
          "    print('Replace PAR_URL with the URL from the instructors before you continue.')",
          "else:",
          "    print('Parameters set.')"
        ],
        "selectedVisualization": "raw",
