        "relations": [],
        "dynamicFormParams": null
      },
      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": "Wo haben Radunfälle zu- oder abgenommen?",
        "hasTitle": true,
        "message": [
          "%python",
          "",
          "centre = gpd.GeoSeries([Point(11.0775, 49.4539)], crs=CRS_STORE).to_crs(CRS_METRIC).iloc[0]   # Hauptmarkt",
          "bike_t['DIST_CENTRE_KM'] = bike_t.distance(centre) / 1000",
          "",
          "by_year = bike_t.groupby('ACC_YEAR').agg(",
          "    BICYCLE_ACCIDENTS=('ID', 'size'),",
          "    WITHIN_2KM_PCT=('DIST_CENTRE_KM', lambda d: round(100 * (d <= 2).mean(), 1)),",
          "    MEDIAN_DIST_KM=('DIST_CENTRE_KM', lambda d: round(d.median(), 2)))",
          "print(by_year.to_string(), '\\n')",
          "",
          "# Unfälle je 1-km-Quadrat in beiden Zeiträumen zählen",
          "bike_t['PERIOD'] = np.where(bike_t['ACC_YEAR'] <= 2022, '2020-2022', '2023-2025')",
          "bike_t['SQ_X'] = (bike_t.geometry.x // 1000) * 1000",
          "bike_t['SQ_Y'] = (bike_t.geometry.y // 1000) * 1000",
          "sq = bike_t.groupby(['SQ_X', 'SQ_Y', 'PERIOD']).size().unstack(fill_value=0).reset_index()",
          "sq['CHANGE'] = sq['2023-2025'] - sq['2020-2022']",
          "sq = gpd.GeoDataFrame(sq, geometry=[box(x, y, x + 1000, y + 1000) for x, y in zip(sq['SQ_X'], sq['SQ_Y'])], crs=CRS_METRIC)",
          "sq = sq[sq['2020-2022'] + sq['2023-2025'] >= 10]",
          "",
          "lonlat = sq.geometry.centroid.to_crs(CRS_STORE)",
          "sq['LON'], sq['LAT'] = lonlat.x.round(4), lonlat.y.round(4)",
          "cols = ['2020-2022', '2023-2025', 'CHANGE', 'LON', 'LAT']",
          "print('Largest increases:\\n', sq.nlargest(3, 'CHANGE')[cols].to_string(index=False), '\\n')",
          "print('Largest decreases:\\n', sq.nsmallest(3, 'CHANGE')[cols].to_string(index=False))",
          "",
          "# Keine Basiskarte: alle Radunfälle in Hellgrau zeigen den Umriss der Stadt",
          "limit = sq['CHANGE'].abs().max()",
          "_, ax = plt.subplots(figsize=(11, 11))",
          "bike_t.plot(ax=ax, color='lightgrey', markersize=1)",
          "sq.plot(ax=ax, column='CHANGE', cmap='RdBu_r', vmin=-limit, vmax=limit, legend=True,",
          "        alpha=0.8, edgecolor='white', legend_kwds={'label': 'Change in bicycle accidents, 2023-2025 minus 2020-2022', 'shrink': 0.6})",
          "gpd.GeoSeries([centre.buffer(2000)], crs=CRS_METRIC).boundary.plot(ax=ax, color='black', linestyle='--', linewidth=1)",
          "ax.set_title('Where did bicycle accidents change? (dashed circle: 2 km around the Hauptmarkt)')",
          "ax.set_axis_off()"
        ],
        "selectedVisualization": "html",
        "visualizationConfig": null,
        "hideCode": false,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": false,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
        "result": null,
        "relations": [],
        "dynamicFormParams": null
