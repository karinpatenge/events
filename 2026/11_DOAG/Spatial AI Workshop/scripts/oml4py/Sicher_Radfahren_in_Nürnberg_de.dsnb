          "xmin, ymin, xmax, ymax = bike_m[in_any].total_bounds",
          "xlim, ylim = (xmin - 1000, xmax + 1000), (ymin - 1000, ymax + 1000)",
          "",
          "# Hier keine Basiskarte: Kartenkacheln für vier Karten zu laden dauert fast eine Minute.",
