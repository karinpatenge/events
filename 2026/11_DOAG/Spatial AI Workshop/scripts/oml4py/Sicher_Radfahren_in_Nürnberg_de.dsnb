          "# Nur Unfälle mit Radbeteiligung",
          "bike_sdf = acc_sdf[acc_sdf['IS_BICYCLE'] == 1]",
          "print(f'All accidents: {acc_sdf.shape[0]:,}   with a bicycle: {bike_sdf.shape[0]:,}   cycling ways: {infra_sdf.shape[0]:,}')",
          "z.show(bike_sdf.head())"
        ],
