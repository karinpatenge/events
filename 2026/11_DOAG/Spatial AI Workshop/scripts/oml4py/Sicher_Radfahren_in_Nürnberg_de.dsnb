      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": "Cluster ordnen: Lenas Top 5",
        "hasTitle": true,
        "message": [
          "%python",
          "",
          "cl = bike_gdf[in_cluster]",
          "summary = cl.groupby('CLUSTER_ID').agg(",
          "    ACCIDENTS         = ('ID', 'size'),",
          "    KILLED_OR_SERIOUS = ('CATEGORY', lambda s: int((s <= 2).sum())),",
          "    SHARE_NEAR_INFRA  = ('DIST_INFRA_M', lambda s: round(float((s <= 25).mean()), 2)),",
          "    MAIN_TYPE         = ('ACCIDENT_TYPE', lambda s: TYPE_NAMES.get(int(s.mode().iat[0]), 'other')),",
          "    NEAREST_STREET    = ('NEAREST_STREET', lambda s: s.mode().iat[0] if s.notna().any() else None),",
          "    X = ('X_UTM32', 'mean'), Y = ('Y_UTM32', 'mean'),",
          ").reset_index()",
          "summary = summary.sort_values(['ACCIDENTS', 'KILLED_OR_SERIOUS'], ascending=False).reset_index(drop=True)",
          "summary.insert(0, 'RANK', np.arange(1, len(summary) + 1))",
          "",
          "summary_gdf = gpd.GeoDataFrame(summary.drop(columns=['X', 'Y']),",
          "                               geometry=gpd.points_from_xy(summary['X'], summary['Y']), crs=CRS_METRIC).to_crs(CRS_STORE)",
          "summary_gdf['LON'] = summary_gdf.geometry.x.round(5)",
          "summary_gdf['LAT'] = summary_gdf.geometry.y.round(5)",
          "z.show(pd.DataFrame(summary_gdf.drop(columns='geometry')).head(5))"
        ],
