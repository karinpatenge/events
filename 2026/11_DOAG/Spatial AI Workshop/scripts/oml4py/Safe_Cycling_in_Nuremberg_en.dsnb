          "%python",
          "",
          "acc_all = acc_sdf.to_crs(CRS_METRIC).as_geodataframe()",
          "bike_t  = acc_all[acc_all['IS_BICYCLE'] == 1].copy()",
          "",
          "MONTHS   = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']",
          "WEEKDAYS = {2: 'Mon', 3: 'Tue', 4: 'Wed', 5: 'Thu', 6: 'Fri', 7: 'Sat', 1: 'Sun'}   # Unfallatlas: 1 = Sunday",
          "",
          "by_month = bike_t['ACC_MONTH'].value_counts().reindex(range(1, 13), fill_value=0)",
          "by_day   = bike_t['WEEKDAY'].value_counts().reindex(list(WEEKDAYS), fill_value=0)",
          "day_kind = np.where(bike_t['WEEKDAY'].isin([1, 7]), 'Sat-Sun', 'Mon-Fri')",
          "by_hour  = bike_t.groupby([day_kind, 'ACC_HOUR']).size().unstack(0).reindex(range(24), fill_value=0)",
          "by_hour  = 100 * by_hour / by_hour.sum()          # share of the accidents of that kind of day",
          "",
          "_, axs = plt.subplots(1, 3, figsize=(18, 5))",
          "axs[0].bar(MONTHS, by_month.values, color='#d7301f')",
          "axs[0].set_title('Bicycle accidents per month, 2020-2025')",
          "axs[1].bar(list(WEEKDAYS.values()), by_day.values, color='#d7301f')",
          "axs[1].set_title('Bicycle accidents per weekday, 2020-2025')",
          "by_hour.plot(ax=axs[2], color=['#d7301f', '#2c7fb8'])",
          "axs[2].set_title('Share of bicycle accidents per hour of the day')",
          "axs[2].set_xlabel('Hour')",
          "axs[2].set_ylabel('% of the accidents on these days')",
          "plt.tight_layout()",
          "",
          "summer = by_month[[5, 6, 7, 8, 9]].sum() / by_month.sum()",
          "print(f'May to September: {summer:.0%} of the bicycle accidents')",
          "print(f'Busiest weekday: {WEEKDAYS[by_day.idxmax()]} ({by_day.max()}), quietest: {WEEKDAYS[by_day.idxmin()]} ({by_day.min()})')",
