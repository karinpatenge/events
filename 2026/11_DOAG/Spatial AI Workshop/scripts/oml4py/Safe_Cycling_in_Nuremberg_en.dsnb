      },
      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": "Read schools, kindergartens, universities and student housing",
        "hasTitle": true,
        "message": [
          "%python",
          "",
          "osm = read(PARObjStoreSpatialDataset(PAR_URL, object_name=DATA_PREFIX + EDU_FILE, driver='GeoJSON')).to_crs(CRS_STORE)",
          "amenity  = osm['amenity']  if 'amenity'  in osm.columns else pd.Series(None, index=osm.index)",
          "building = osm['building'] if 'building' in osm.columns else pd.Series(None, index=osm.index)",
          "kind = np.where(amenity.isin(['school', 'kindergarten', 'university', 'college']), amenity,",
          "                np.where(building == 'dormitory', 'dormitory', None))",
          "",
          "edu_gdf = gpd.GeoDataFrame({'OSM_ID': osm['@id'], 'NAME': osm['name'], 'KIND': kind},",
          "                           geometry=osm.geometry, crs=CRS_STORE)",
          "edu_gdf = edu_gdf[edu_gdf['KIND'].notna()].reset_index(drop=True)",
          "",
          "write(edu_gdf, DBSpatialDataset(table=T_EDU), if_exists='replace', create_spatial_index=True)",
          "print(f'Table {T_EDU}: {len(edu_gdf):,} places written, spatial index created.')"
        ],
        "selectedVisualization": "raw",
        "visualizationConfig": null,
        "hideCode": false,
