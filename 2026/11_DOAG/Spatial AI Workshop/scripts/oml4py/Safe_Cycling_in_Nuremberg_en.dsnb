        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%md",
          "",
          "###### Expected result",
          "A map of Nuremberg on a basemap: blue lines for the cycling infrastructure and red dots for the 4,387 bicycle accidents. The dots are densest in the old town, around the ring road and along the main roads into the centre. At first sight, accidents seem to be everywhere along the cycling network."
        ],
        "selectedVisualization": "html",
        "visualizationConfig": null,
        "hideCode": true,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": true,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
        "result": null,
        "relations": [],
        "dynamicFormParams": null
      },
      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": "Bicycle accidents by type of accident",
        "hasTitle": true,
        "message": [
          "%sql",
          "",
          "SELECT CASE accident_type",
          "         WHEN 1 THEN '1 Driving accident (loss of control)'",
          "         WHEN 2 THEN '2 Turning'",
          "         WHEN 3 THEN '3 Turning into a road or crossing'",
          "         WHEN 4 THEN '4 Pedestrian crossing the road'",
          "         WHEN 5 THEN '5 Stationary traffic (parking)'",
          "         WHEN 6 THEN '6 Moving along in the same lane'",
          "         ELSE        '7 Other'",
          "       END                                      AS type_of_accident,",
          "       COUNT(*)                                 AS accidents,",
          "       SUM(CASE WHEN category <= 2 THEN 1 ELSE 0 END) AS killed_or_serious",
          "FROM   nue_accidents",
          "WHERE  is_bicycle = 1",
          "GROUP  BY accident_type",
          "ORDER  BY accident_type"
        ],
