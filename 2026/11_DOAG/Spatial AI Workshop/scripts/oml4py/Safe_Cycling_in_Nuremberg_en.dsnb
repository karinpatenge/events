          "infra_gdf = infra_gdf[['osm_id', 'category', 'name', 'highway', 'length_m', 'surface', 'lit', 'maxspeed', 'geometry']]",
          "infra_gdf.columns = ['OSM_ID', 'CATEGORY', 'NAME', 'HIGHWAY', 'LENGTH_M', 'SURFACE', 'LIT', 'MAXSPEED', 'geometry']",
          "",
          "write(infra_gdf, DBSpatialDataset(table=T_INFRA), if_exists='replace', create_spatial_index=True)",
          "print(f'Table {T_INFRA}: {len(infra_gdf):,} ways written, spatial index created.')"
        ],
