      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": "Residents by age group around Nuremberg",
        "hasTitle": true,
        "message": [
          "%sql",
          "",
          "SELECT COUNT(*)                                   AS grid_cells,",
          "       SUM(population)                            AS residents,",
          "       SUM(under_18)                              AS under_18,",
          "       SUM(age_18_29)                             AS age_18_29,",
          "       SUM(age_65_plus)                           AS age_65_plus,",
          "       ROUND(100 * AVG(CASE WHEN age_18_29 IS NULL THEN 1 ELSE 0 END)) AS pct_cells_18_29_suppressed",
          "FROM   nue_census_grid"
        ],
        "selectedVisualization": "table",
        "visualizationConfig": null,
        "hideCode": false,
        "hideResult": false,
