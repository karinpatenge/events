        "sizeX": 0,
        "width": 12,
        "title": "Distance from each bicycle accident to the nearest cycling way",
        "hasTitle": true,
        "message": [
          "%python",
          "",
          "TYPE_NAMES = {1: 'driving', 2: 'turning', 3: 'turning into / crossing', 4: 'pedestrian crossing',",
          "              5: 'parking', 6: 'moving along', 7: 'other'}",
          "",
          "bike_gdf = bike_m.copy()                     # bicycle accidents from Part 4, same order as labels",
          "bike_gdf['CLUSTER_ID'] = labels",
          "",
          "infra_m = infra_sdf.to_crs(CRS_METRIC).as_geodataframe()[['CATEGORY', 'NAME', 'geometry']]",
          "infra_m = infra_m.rename(columns={'CATEGORY': 'NEAREST_INFRA', 'NAME': 'NEAREST_STREET'})",
          "nearest = gpd.sjoin_nearest(bike_gdf[['geometry']], infra_m, how='left', distance_col='DIST_INFRA_M')",
          "nearest = nearest[~nearest.index.duplicated()]           # ties: keep one cycling way per accident",
          "bike_gdf['DIST_INFRA_M']   = nearest['DIST_INFRA_M'].round(1)",
          "bike_gdf['NEAREST_INFRA']  = nearest['NEAREST_INFRA']",
          "bike_gdf['NEAREST_STREET'] = nearest['NEAREST_STREET']",
          "",
          "near = bike_gdf['DIST_INFRA_M'] <= 25",
          "in_cluster = bike_gdf['CLUSTER_ID'] >= 0",
          "print(f'Within 25 m of a cycling way: all bicycle accidents {near.mean():.0%}, '",
          "      f'in clusters {near[in_cluster].mean():.0%}, outside clusters {near[~in_cluster].mean():.0%}')",
          "print(f'Turning accidents (type 2): in clusters {(bike_gdf.loc[in_cluster, \"ACCIDENT_TYPE\"] == 2).mean():.0%}, '",
          "      f'outside clusters {(bike_gdf.loc[~in_cluster, \"ACCIDENT_TYPE\"] == 2).mean():.0%}')"
        ],
