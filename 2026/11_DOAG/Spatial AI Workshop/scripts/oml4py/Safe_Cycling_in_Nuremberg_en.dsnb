          "",
          "_, ax = plt.subplots(figsize=(12, 12))",
          "plot_clusters(X, labels, title=f'DBSCAN clusters (eps={EPS_METRES} m, min_samples={MIN_SAMPLES})',",
          "              with_noise=False, with_bounds=False, ax=ax, cmap='tab20', with_basemap=True)"
        ],
