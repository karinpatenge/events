          "stats = hits.groupby('OSM_ID').agg(BIKE_ACC_150M=('CATEGORY', 'size'),",
          "                                   KILLED_OR_SERIOUS_150M=('CATEGORY', lambda s: int((s <= 2).sum())))",
          "edu_m = edu_m.drop(columns=['BIKE_ACC_150M', 'KILLED_OR_SERIOUS_150M'], errors='ignore').merge(stats, on='OSM_ID', how='left')",
          "edu_m[['BIKE_ACC_150M', 'KILLED_OR_SERIOUS_150M']] = edu_m[['BIKE_ACC_150M', 'KILLED_OR_SERIOUS_150M']].fillna(0).astype(int)",
          "",
          "ranked = summary_gdf.to_crs(CRS_METRIC)[['RANK', 'geometry']].rename(columns={'RANK': 'NEAREST_CLUSTER_RANK'})",
          "near = gpd.sjoin_nearest(edu_m[['geometry']], ranked, how='left', distance_col='DIST_CLUSTER_M')",
