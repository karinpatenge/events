        "title": "Import libraries",
        "hasTitle": true,
        "message": [
          "%python",
          "",
          "import numpy as np",
          "import pandas as pd",
          "import geopandas as gpd",
          "import matplotlib.pyplot as plt",
          "from matplotlib.colors import ListedColormap",
          "from shapely.geometry import Point, Polygon, box",
          "from sklearn import metrics",
          "",
          "import oml",
          "",
          "# Spatial AI (oraclesai) is installed together with OML4Py",
          "from oraclesai import SpatialDataFrame, DBSpatialDataset, GeoDataFrameDataset, PARObjStoreSpatialDataset, read, write",
          "from oraclesai.preprocessing import SCoordTransformer",
          "from oraclesai.clustering import DBScanClustering, LISAHotspotClustering",
          "from oraclesai.weights import SpatialWeights, KNNWeightsDefinition",
          "from oraclesai.analysis import MoranITest",
          "from oraclesai.regression import OLSRegressor, GWRRegressor",
          "from oraclesai.pipeline import SpatialPipeline",
          "from oraclesai.vis import plot_clusters",
          "from oraclesai import enable_geodataframes",
          "enable_geodataframes(z)",
          "",
          "# Reproducible results",
          "import random",
          "random_state = 456",
          "random.seed(random_state)",
          "np.random.seed(random_state)",
          "",
          "print('Libraries loaded. Connected to the database:', oml.isconnected())"
        ],
