        "sizeX": 0,
        "width": 12,
        "title": null,
        "hasTitle": false,
        "message": [
          "%md",
          "",
          "###### Expected result",
          "```",
          "Table NUE_CENSUS_GRID: 11,780 rows written, spatial index created.",
          "```",
          "Every row is a 100 m square with its residents by age group, stored in longitude/latitude like the other tables."
        ],
        "selectedVisualization": "html",
