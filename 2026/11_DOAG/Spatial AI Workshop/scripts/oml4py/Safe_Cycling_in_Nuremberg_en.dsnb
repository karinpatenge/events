        "message": [
          "%md",
          "",
          "###### Workshop parameters",
          "",
          "* `PAR_URL` - pre-authenticated request (PAR) for the workshop bucket in OCI Object Storage. **Replace the placeholder with the URL from the instructors.** It ends with `/o/`.",
          "* `ACCIDENT_FILES` - one Unfallatlas file per year, exactly as published. Each file covers all of Germany (about 270,000 accidents). Fewer years load faster.",
          "* `CENSUS_FILE`, `EDU_FILE` - the Zensus 2022 grid with residents by age group, cut to Bavaria, and the schools, kindergartens, universities and student housing from OpenStreetMap.",
          "* `REGION_AGS` - official municipality key (AGS). `09564000` is the city of Nuremberg.",
          "* `CRS_METRIC` - ETRS89 / UTM zone 32N (EPSG:25832), the official projected coordinate system in Bavaria. Distances are in metres. Clustering and spatial weights need projected coordinates."
        ],
        "selectedVisualization": "html",
        "visualizationConfig": null,
        "hideCode": true,
        "hideResult": false,
        "hideGutter": true,
        "hideVizConfig": true,
        "hideInIFrame": false,
        "enabled": true,
        "forms": "[]",
        "result": null,
        "relations": [],
        "dynamicFormParams": null
      },
      {
        "row": 0,
        "col": 0,
        "sizeX": 0,
        "width": 12,
        "title": "Set workshop parameters",
        "hasTitle": true,
        "message": [
          "%python",
          "",
          "# ---- Object Storage (from the workshop instructors) ---------------------------------",
          "PAR_URL     = 'https://objectstorage.<region>.oraclecloud.com/p/<token>/n/<namespace>/b/<bucket>/o/'",
          "DATA_PREFIX = ''          # folder in the bucket, e.g. 'data/' - empty if the files are at the top level",
          "",
          "# ---- Source files (Unfallatlas, one per year; 2021 is published as .txt) --",
          "ACCIDENT_FILES = {",
          "    2020: 'Unfallorte2020_LinRef.csv',",
          "    2021: 'Unfallorte2021_LinRef.txt',",
          "    2022: 'Unfallorte2022_LinRef.csv',",
          "    2023: 'Unfallorte2023_LinRef.csv',",
          "    2024: 'Unfallorte2024_LinRef.csv',",
          "    2025: 'Unfallorte2025_LinRef.csv',",
          "}",
          "INFRA_FILE  = 'nuremberg_bicycle_infrastructure.geojson'",
          "CENSUS_FILE = 'Zensus2022_Alter_in_5_Altersklassen_100m-Gitter_Bayern.csv'   # Bavarian part, about 37 MB",
          "EDU_FILE    = 'nuremberg_housing_data.geojson'                         # schools, kindergartens, universities, student housing",
          "",
          "# ---- Region and coordinate systems ----------------------------------------",
          "REGION_AGS = '09564000'    # Nuremberg (city)",
          "CRS_SOURCE = 'EPSG:25832'  # coordinates in the Unfallatlas files (LINREFX, LINREFY)",
          "CRS_METRIC = 'EPSG:25832'  # for distances in metres",
          "CRS_STORE  = 'EPSG:4326'   # WGS84 longitude/latitude, stored in the database",
          "CRS_CENSUS = 'EPSG:3035'   # ETRS89 / LAEA Europe, coordinate system of the census grid",
          "",
          "# ---- Tables created by this notebook (all replaced on every run) ----------",
          "T_ACCIDENTS = 'NUE_ACCIDENTS'",
          "T_INFRA     = 'NUE_BIKE_INFRA'",
          "T_CENSUS    = 'NUE_CENSUS_GRID'",
          "T_EDU       = 'NUE_EDUCATION'",
          "T_EDU_RISK  = 'NUE_EDUCATION_SURROUNDINGS'",
          "T_CLUSTERS  = 'NUE_BIKE_ACCIDENT_CLUSTERS'",
          "T_GRID      = 'NUE_HOTSPOT_GRID'",
          "T_SUMMARY   = 'NUE_CLUSTER_SUMMARY'",
          "",
          "if '<token>' in PAR_URL:",
          "    print('Replace PAR_URL with the URL from the instructors before you continue.')",
          "else:",
          "    print('Parameters set.')"
        ],
