      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 0,
        "title" : "Create the GTFS table and store the ZET GTFS data file into a staging table",
        "hasTitle" : true,
        "message" : [
          "%script\r",
          "\r",
          "DROP TABLE IF EXISTS zet_gtfs_files PURGE;\r",
          "\r",
          "CREATE TABLE zet_gtfs_files (\r",
          "  id          INTEGER GENERATED ALWAYS AS IDENTITY (START WITH 1 INCREMENT BY 1 CACHE 1000 MAXVALUE 9999999999)\r",
          "              CONSTRAINT zet_gtfs_files_pk PRIMARY KEY,\r",
          "  source_url  VARCHAR2(400) NOT NULL,\r",
          "  fetched_at  TIMESTAMP DEFAULT ON NULL SYS_EXTRACT_UTC(SYSTIMESTAMP) NOT NULL,\r",
          "  content     BLOB NOT NULL\r",
          ")\r",
          "ANNOTATIONS (Description 'ZET GTFS schedule as downloaded (ZIP)');\r",
          "\r",
          "DECLARE\r",
          "  c_url CONSTANT VARCHAR2(400) := 'https://zet.hr/gtfs-scheduled/latest';   -- public URL, no credential\r",
          "BEGIN\r",
          "  INSERT INTO zet_gtfs_files (source_url, content)\r",
          "  VALUES (c_url, DBMS_CLOUD.GET_OBJECT(credential_name => NULL, object_uri => c_url));\r",
          "  COMMIT;\r",
          "END;\r",
          "/\r"
        ],
