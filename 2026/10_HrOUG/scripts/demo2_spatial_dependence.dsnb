      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 0,
        "title" : "Load the GTFS data into a dataframe",
        "hasTitle" : true,
        "message" : [
          "%python",
          "",
          "import io",
          "import zipfile",
          "import pandas as pd",
          "import oml",
          "",
          "REF_DATE = '20261014'          # a Wednesday of the feed: weekday departures are counted for this date",
          "MODES = {'0': 'TRAM', '3': 'BUS', '7': 'FUNICULAR'}",
          "",
          "# one row per station, with mode, platforms and weekday departures",
          "",
          "# The GTFS ZIP downloaded by the previous paragraph",
          "cur = oml.cursor()",
          "cur.execute('SELECT content FROM zet_gtfs_files ORDER BY fetched_at DESC FETCH FIRST 1 ROW ONLY')",
          "gtfs = zipfile.ZipFile(io.BytesIO(cur.fetchone()[0].read()))",
          "cur.close()",
          "",
          "def read(name, **kw):",
          "    return pd.read_csv(gtfs.open(name), dtype=str, encoding='utf-8-sig', keep_default_na=False, **kw)",
          "",
          "stops      = read('stops.txt')",
          "routes     = read('routes.txt', usecols=['route_id', 'route_type'])",
          "trips      = read('trips.txt', usecols=['trip_id', 'route_id', 'service_id'])",
          "stop_times = read('stop_times.txt', usecols=['trip_id', 'stop_id'])",
          "calendar   = read('calendar.txt')",
          "cal_dates  = read('calendar_dates.txt')",
          "",
          "# Services that run on REF_DATE (calendar.txt plus the exceptions in calendar_dates.txt)",
          "weekday = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'][pd.Timestamp(REF_DATE).dayofweek]",
          "active = set(calendar.loc[(calendar[weekday] == '1') & (calendar['start_date'] <= REF_DATE)",
          "                          & (calendar['end_date'] >= REF_DATE), 'service_id'])",
          "on_date = cal_dates[cal_dates['date'] == REF_DATE]",
          "active = (active | set(on_date.loc[on_date['exception_type'] == '1', 'service_id'])) \\",
          "         - set(on_date.loc[on_date['exception_type'] == '2', 'service_id'])",
          "",
          "# Platforms (location_type 0) belong to stations (location_type 1); one row per station",
          "platforms = stops[stops['location_type'].isin(['', '0'])][['stop_id', 'parent_station']]",
          "stations  = stops[stops['location_type'] == '1'][['stop_id', 'stop_name', 'stop_lon', 'stop_lat']]",
          "",
          "calls = (stop_times.merge(trips, on='trip_id')",
          "                   .merge(routes, on='route_id')",
          "                   .merge(platforms, on='stop_id'))",
          "calls['station_id'] = calls['parent_station'].where(calls['parent_station'] != '', calls['stop_id'])",
          "",
          "mode       = calls.groupby('station_id')['route_type'].agg(lambda t: '/'.join(sorted({MODES.get(x, x) for x in t})))",
          "departures = calls[calls['service_id'].isin(active)].groupby('station_id').size()",
          "n_platform = platforms.groupby('parent_station').size()",
          "",
          "zet_stops = pd.DataFrame({",
          "    'STOP_ID':            stations['stop_id'],",
          "    'STOP_NAME':          stations['stop_name'],",
          "    'TRANSPORT_MODE':     stations['stop_id'].map(mode),",
          "    'PLATFORMS':          stations['stop_id'].map(n_platform).fillna(0).astype(int),",
          "    'WEEKDAY_DEPARTURES': stations['stop_id'].map(departures).fillna(0).astype(int),",
          "    'LON':                stations['stop_lon'].astype(float),",
          "    'LAT':                stations['stop_lat'].astype(float),",
          "})",
          "zet_stops = zet_stops[zet_stops['TRANSPORT_MODE'].notna()].reset_index(drop=True)   # stations with service only",
          "",
          "# Staging table for the SQL paragraph",
          "try:",
          "    oml.drop(table='ZET_STOPS_STAGE')",
          "except Exception:",
          "    pass",
          "oml.create(zet_stops, table='ZET_STOPS_STAGE')",
          "",
          "print(f\"services on {REF_DATE}: {sorted(active)}\")",
          "print(f\"{len(zet_stops):,} stations: {zet_stops['TRANSPORT_MODE'].value_counts().to_dict()}, \"",
          "      f\"{zet_stops['WEEKDAY_DEPARTURES'].sum():,} weekday departures\")",
          "z.show(zet_stops.sort_values('WEEKDAY_DEPARTURES', ascending=False).head(10)) "
        ],
