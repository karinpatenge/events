        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : "Count the contiguous heat islands and cool islands and their size",
        "hasTitle" : true,
        "message" : [
          "%python",
          "",
          "area_km2 = (X.as_geodataframe().geometry.area / 1e6).values          # cell areas in km² (projected)",
          "",
          "for q in (1, 3):",
          "    regions = sorted(lisa.regions_.get(q, []), key=len, reverse=True)",
          "    sizes = [area_km2[list(r)].sum() for r in regions]",
          "    print(f\"{LABELS[q]}: {len(regions)} contiguous regions, {sum(sizes):.1f} km² in total; \"",
          "          f\"largest: {', '.join(f'{s:.1f} km²' for s in sizes[:5])}\")"
        ],
        "selectedVisualization" : "raw",
        "visualizationConfig" : null,
        "hideCode" : false,
