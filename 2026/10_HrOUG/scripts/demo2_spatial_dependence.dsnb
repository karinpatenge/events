        "title" : "Import required libraries",
        "hasTitle" : true,
        "message" : [
          "%python",
          "",
          "import numpy as np",
          "import pandas as pd",
          "import geopandas as gpd",
          "import matplotlib.pyplot as plt",
          "from matplotlib.colors import LinearSegmentedColormap",
          "",
          "import oml",
          "",
          "# Spatial AI imports",
          "from oraclesai import SpatialDataFrame, DBSpatialDataset",
          "from oraclesai.analysis import MoranITest",
          "from oraclesai.clustering import LISAHotspotClustering",
          "from oraclesai.weights import KNNWeightsDefinition",
          "from oraclesai.vis import plot_clusters",
          "from oraclesai import enable_geodataframes",
          "enable_geodataframes(z)",
          "",
          "# Needed for reproducibility of the permutation tests",
          "random_state = 456",
          "",
          "# Distances need projected coordinates: HTRS96 / Croatia TM, in metres",
          "ANALYSIS_CRS = 'epsg:3765'",
          "",
          "# LISA quadrants as text, and map colours (Redwood palette)",
          "LABELS = {1: 'HEAT ISLAND (HH)', 2: 'COOL OUTLIER (LH)', 3: 'COOL ISLAND (LL)', 4: 'HOT OUTLIER (HL)'}",
          "COLORS = {'HEAT ISLAND (HH)': '#FF0000', 'COOL OUTLIER (LH)': '#0fbaf3ff', 'COOL ISLAND (LL)': '#0000FF',",
          "          'HOT OUTLIER (HL)': '#f6b309ff', 'STOP': '#161717ff'}",
          "",
          "def label_cmap(labels):",
          "    \"\"\"Colour map in the sorted order of the labels that are present.\"\"\"",
          "    colors = [COLORS[l] for l in sorted(set(labels))]",
          "    return LinearSegmentedColormap.from_list('lisa', colors if len(colors) > 1 else colors * 2, N=len(colors))"
        ],
