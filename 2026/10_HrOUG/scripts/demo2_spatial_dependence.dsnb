          "DROP TABLE IF EXISTS zet_stops PURGE;",
          "",
          "CREATE TABLE zet_stops (",
          "  id                  INTEGER",
          "                      GENERATED ALWAYS AS IDENTITY (START WITH 1 INCREMENT BY 1 CACHE 1000 MAXVALUE 9999999999)",
          "                      CONSTRAINT zet_stops_pk PRIMARY KEY",
          "                      ANNOTATIONS (Description 'Surrogate key'),",
          "  stop_id             VARCHAR2(30)",
          "                      NOT NULL",
          "                      CONSTRAINT zet_stops_uk UNIQUE",
          "                      ANNOTATIONS (Description 'GTFS stop_id of the station (location_type 1)'),",
          "  stop_name           VARCHAR2(100)",
          "                      NOT NULL",
          "                      ANNOTATIONS (Description 'Stop name as in the ZET GTFS'),",
          "  transport_mode      VARCHAR2(30)",
          "                      NOT NULL",
          "                      ANNOTATIONS (Description 'Vehicles serving the stop: TRAM or BUS'),",
          "  platforms           NUMBER(3)",
          "                      NOT NULL",
          "                      ANNOTATIONS (Description 'Number of platforms (GTFS location_type 0) of the station'),",
          "  weekday_departures  NUMBER(6)",
          "                      NOT NULL",
          "                      ANNOTATIONS (Description 'Trips calling at the stop on a weekday, all platforms'),",
          "  geom                SDO_GEOMETRY",
          "                      NOT NULL",
          "                      ANNOTATIONS (Description 'Station location, WGS84 lon/lat (SRID 4326)')",
          ")",
          "ANNOTATIONS (",
          "  Display 'ZET stops',",
          "  Description 'ZET tram and bus stops (GTFS stations) with transport mode, platforms and weekday departures'",
          ");",
          "",
          "INSERT INTO zet_stops (stop_id, stop_name, transport_mode, platforms, weekday_departures, geom)",
          "SELECT stop_id, stop_name, transport_mode, platforms, weekday_departures, SDO_GEOMETRY(lon, lat)",
          "FROM zet_stops_stage;",
          "COMMIT;",
          "",
          "CREATE INDEX zet_stops_sidx ON zet_stops (geom)",
          "  INDEXTYPE IS MDSYS.SPATIAL_INDEX_V2",
          "  PARAMETERS ('layer_gtype=POINT cbtree_index=true');",
          "",
          "-- GTFS IDs of the hook stops A-D (the column was left empty for this step)",
          "UPDATE tram_stations",
          "SET    gtfs_stop_id = CASE station_code WHEN 'A' THEN '106' WHEN 'B' THEN '107' WHEN 'C' THEN '109' WHEN 'D' THEN '113' END",
          "WHERE  station_code IN ('A', 'B', 'C', 'D');",
          "COMMIT;",
          "",
          "DROP TABLE IF EXISTS zet_stops_stage PURGE;",
          "DROP TABLE IF EXISTS zet_gtfs_files PURGE;      -- keep it if you want to reuse the downloaded feed"
