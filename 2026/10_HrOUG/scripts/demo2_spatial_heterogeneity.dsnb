      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : "Create ZG_H3_FEATURES: surface temperature and land cover per H3 cell",
        "hasTitle" : true,
        "message" : [
          "%script",
          "",
          "DROP TABLE IF EXISTS zg_h3_features PURGE;",
          "",
          "CREATE TABLE zg_h3_features (",
          "  id          INTEGER",
          "              GENERATED ALWAYS AS IDENTITY (START WITH 1 INCREMENT BY 1 CACHE 1000 MAXVALUE 9999999999)",
          "              CONSTRAINT zg_h3_features_pk PRIMARY KEY",
          "              ANNOTATIONS (Description 'Surrogate key'),",
          "  h3_id       VARCHAR2(16)",
          "              NOT NULL",
          "              CONSTRAINT zg_h3_features_uk UNIQUE",
          "              ANNOTATIONS (Description 'H3 cell at resolution 9, hex string of SDO_UTIL.H3_KEY'),",
          "  lst_c       NUMBER(5,2)",
          "              NOT NULL",
          "              ANNOTATIONS (Description 'Mean land surface temperature in degrees Celsius, Landsat 8, 2 August 2026, 09:39 UTC'),",
          "  canopy_pct  NUMBER(4,1)",
          "              NOT NULL",
          "              ANNOTATIONS (Description 'Tree cover in percent of the cell (ESA WorldCover 2021, class 10)'),",
          "  green_pct   NUMBER(4,1)",
          "              NOT NULL",
          "              ANNOTATIONS (Description 'Shrubs, grass, cropland and wetland in percent of the cell (classes 20, 30, 40, 90, 95, 100)'),",
          "  water_pct   NUMBER(4,1)",
          "              NOT NULL",
          "              ANNOTATIONS (Description 'Permanent water in percent of the cell (class 80)'),",
          "  built_pct   NUMBER(4,1)",
          "              NOT NULL",
          "              ANNOTATIONS (Description 'Built-up and bare ground in percent of the cell (classes 50, 60); reference category of the models'),",
          "  geom        SDO_GEOMETRY",
          "              NOT NULL",
          "              ANNOTATIONS (Description 'H3 cell polygon, WGS84 lon/lat (SRID 4326)')",
          ")",
          "ANNOTATIONS (",
          "  Display 'Zagreb H3 cells with land cover',",
          "  Description 'H3 cells over the City of Zagreb with surface temperature and land cover shares, input of the Spatial AI models'",
          ");",
          "",
          "INSERT INTO zg_h3_features (h3_id, lst_c, canopy_pct, green_pct, water_pct, built_pct, geom)",
          "SELECT c.h3_id, c.lst_c, s.canopy_pct, s.green_pct, s.water_pct, s.built_pct, c.geom",
          "FROM zg_h3_cells c",
          "JOIN zg_h3_landcover_stage s ON s.h3_id = c.h3_id;",
          "COMMIT;",
          "",
          "CREATE INDEX zg_h3_features_sidx ON zg_h3_features (geom)",
          "  INDEXTYPE IS MDSYS.SPATIAL_INDEX_V2",
          "  PARAMETERS ('layer_gtype=POLYGON');",
          "",
          "BEGIN",
          "  DBMS_STATS.GATHER_TABLE_STATS(ownname => USER, tabname => 'ZG_H3_FEATURES');",
          "END;",
          "/",
          "",
          "DROP TABLE IF EXISTS zg_h3_landcover_stage PURGE;",
          "DROP TABLE IF EXISTS zg_worldcover_files PURGE;"
        ],
