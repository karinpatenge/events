        "message" : [
          "%python",
          "",
          "def what_if(stop_ids, extra_pp=15):",
          "    \"\"\"Predict the temperature of the stops' cells now and with extra_pp canopy instead of built-up area.\"\"\"",
          "    sel = stops[stops['STOP_ID'].isin(stop_ids)][['STOP_ID', 'STOP_NAME', 'H3_ID']].drop_duplicates('STOP_ID')",
          "    rows = cells_gdf.merge(sel, on='H3_ID')",
          "    now = rows[FEATURES + ['geometry']].copy()",
          "    more = now.copy()",
          "    gain = np.minimum(extra_pp, rows['BUILT_PCT'].to_numpy())",
          "    more['CANOPY_PCT'] = now['CANOPY_PCT'].to_numpy() + gain",
          "    predict = lambda gdf: np.ravel(gwr_pipe.predict(SpatialDataFrame.from_geodataframe(gdf)))",
          "    p_now, p_more = predict(now), predict(more)",
          "    return pd.DataFrame({'STOP': rows['STOP_NAME'], 'LST_C': rows[TARGET], 'CANOPY_PCT': rows['CANOPY_PCT'],",
          "                         'CANOPY_GAIN_PP': gain, 'PREDICTED_NOW_C': p_now.round(2),",
          "                         'PREDICTED_WITH_TREES_C': p_more.round(2), 'CHANGE_C': (p_more - p_now).round(2)})",
          "",
          "top_stop = hot['STOP_ID'].iloc[0]",
          "z.show(what_if(['106', '185', top_stop]))"
        ],
