        "title" : "Import required libraries",
        "hasTitle" : true,
        "message" : [
          "%python",
          "",
          "import io",
          "import time",
          "import numpy as np",
          "import pandas as pd",
          "import geopandas as gpd",
          "import matplotlib.pyplot as plt",
          "import sklearn.metrics as metrics",
          "import warnings",
          "warnings.filterwarnings('ignore')",
          "pd.options.display.max_columns = None",
          "",
          "import oml",
          "",
          "# Spatial AI imports",
          "from oraclesai import SpatialDataFrame, DBSpatialDataset",
          "from oraclesai.regression import GWRRegressor, OLSRegressor",
          "from oraclesai.pipeline import SpatialPipeline",
          "from oraclesai.weights import KNNWeightsDefinition",
          "from oraclesai import enable_geodataframes",
          "enable_geodataframes(z)",
          "",
          "# Distances need projected coordinates: HTRS96 / Croatia TM, in metres",
          "ANALYSIS_CRS = 'epsg:3765'",
          "",
          "# Target and explanatory variables. Built-up area (and the rare water) is the reference category: a coefficient",
          "# means \"this land cover instead of built-up area\", in degrees Celsius per percentage point.",
          "# WATER_PCT is not a model variable: about half of the GWR neighbourhoods contain no water at all, and a",
          "# variable that is 0 in every neighbour makes the local regression unsolvable (singular matrix).",
          "TARGET = 'LST_C'",
          "FEATURES = ['CANOPY_PCT', 'GREEN_PCT']"
        ],
