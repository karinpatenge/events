          "",
          "cells_out = cells_sdf[['H3_ID', TARGET, 'geometry']]",
          "for name, values in [('B_INTERCEPT', betas[:, 0]), ('B_CANOPY', betas[:, 1]), ('B_GREEN', betas[:, 2]),",
