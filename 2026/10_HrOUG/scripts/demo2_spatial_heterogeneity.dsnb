        "message" : [
          "%python",
          "",
          "start = time.time()",
          "gwr_pipe = SpatialPipeline([('gwr', GWRRegressor(spatial_weights_definition=KNNWeightsDefinition(k=200)))])",
          "gwr_pipe.fit(X_model, TARGET)",
          "gwr = gwr_pipe.named_steps['gwr']",
          "print(f\"{len(cells_gdf):,} local regressions in {time.time() - start:.0f} s\")",
          "print(gwr.summary)"
        ],
