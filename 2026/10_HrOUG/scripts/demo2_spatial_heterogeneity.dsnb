          "                     ('PRED_C', np.ravel(gwr.predy)), ('RESID_C', np.ravel(gwr.u))]:",
          "    cells_out = cells_out.add_column(name, values)",
          "cells_out.write(DBSpatialDataset(table='ZG_H3_GWR'), if_exists='replace',",
          "                create_spatial_metadata=True, create_spatial_index=True)",
          "",
          "oml.ds.save(objs={'zg_gwr_pipe': gwr_pipe, 'zg_ols_pipe': ols_pipe}, name='zg_heat_models',",
