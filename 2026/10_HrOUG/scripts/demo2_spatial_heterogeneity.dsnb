          "",
          "-- Expected: as many cells as ZG_H3_CELLS; the four shares add up to 100 % (up to rounding)",
          "SELECT",
          "  f.*,",
          "  c.cells_in_zg_h3_cells",
          "FROM",
          "  (SELECT",
          "     COUNT(*) AS cells,",
          "     ROUND(AVG(lst_c), 1) AS mean_lst_c,",
          "     ROUND(AVG(canopy_pct), 1) AS canopy,",
          "     ROUND(AVG(green_pct), 1) AS green,",
          "     ROUND(AVG(water_pct), 1) AS water,",
          "     ROUND(AVG(built_pct), 1) AS built,",
          "     ROUND(MAX(ABS(canopy_pct + green_pct + water_pct + built_pct - 100)), 1) AS max_deviation_from_100",
          "   FROM",
          "     zg_h3_features) f",
          "  CROSS JOIN",
          "  (SELECT COUNT(*) AS cells_in_zg_h3_cells FROM zg_h3_cells) c"
