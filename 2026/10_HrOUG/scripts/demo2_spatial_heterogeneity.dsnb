              "message" : "\nTable ZG_WORLDCOVER_FILES dropped.\n\n\n---------------------------\n\nTable ZG_WORLDCOVER_FILES created.\n\n\n---------------------------\n\nPL/SQL procedure successfully completed.\n\n\n---------------------------\n\n---------------------------\n",
              "type" : "TEXT"
