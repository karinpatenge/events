        "enabled" : true,
        "forms" : "[]",
        "result" : {
          "interpreter" : "md.low",
          "taskStatus" : "SUCCESS",
          "status" : "SUCCESS",
          "results" : [
            {
              "message" : "<h6 id=\"prepare-land-cover-per-h3-cell\">Prepare land cover per H3 cell</h6>\n<p>The explanatory variables come from <a rel=\"nofollow\" href=\"https://esa-worldcover.org\">ESA WorldCover 2021</a> (10 m land cover classes), grouped per H3 cell:</p>\n<table>\n<thead>\n<tr>\n<th>Variable</th>\n<th>WorldCover classes</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code>CANOPY_PCT</code></td>\n<td>10 tree cover</td>\n</tr>\n<tr>\n<td><code>GREEN_PCT</code></td>\n<td>20 shrubland, 30 grassland, 40 cropland, 90 herbaceous wetland, 95 mangroves, 100 moss and lichen</td>\n</tr>\n<tr>\n<td><code>WATER_PCT</code></td>\n<td>80 permanent water bodies: stored, but not a model variable (see <em>2. Do trees cool the same everywhere?</em>)</td>\n</tr>\n<tr>\n<td><code>BUILT_PCT</code></td>\n<td>50 built-up, 60 bare or sparse vegetation: the reference category (together with water), not a model variable</td>\n</tr>\n</tbody>\n</table>\n<ol>\n<li>The database downloads the land cover for the extent of the surface temperature raster: 3 × 3 cells of 10 m per 30 m pixel, as a NumPy array.</li>\n<li>Python computes the share of each group per 30 m pixel and averages it per H3 cell, over the valid pixels in <code>ZG_LST_PIXELS</code>. Surface temperature and land cover use the same pixels.</li>\n<li>SQL creates <code>ZG_H3_FEATURES</code>.</li>\n</ol>\n<p>The land cover map is from 2021, the surface temperature from 2026; changes in between are not captured.</p>\n<p>Run this section once. The analysis starts at <em>1. How much do trees cool on average?</em></p>\n",
              "type" : "HTML"
            }
          ],
          "forms" : "[]"
        },
        "relations" : [ ],
        "dynamicFormParams" : "{}"
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : "Download ESA WorldCover for the extent of the surface temperature raster",
        "hasTitle" : true,
        "message" : [
          "%script",
          "",
          "DROP TABLE IF EXISTS zg_worldcover_files PURGE;",
          "",
          "CREATE TABLE zg_worldcover_files (",
          "  id          INTEGER GENERATED ALWAYS AS IDENTITY (START WITH 1 INCREMENT BY 1 CACHE 1000 MAXVALUE 9999999999)",
          "              CONSTRAINT zg_worldcover_files_pk PRIMARY KEY,",
          "  source_url  VARCHAR2(1000) NOT NULL,",
          "  minx        NUMBER NOT NULL,",
          "  miny        NUMBER NOT NULL,",
          "  maxx        NUMBER NOT NULL,",
          "  maxy        NUMBER NOT NULL,",
          "  lst_rows    NUMBER NOT NULL,",
          "  lst_cols    NUMBER NOT NULL,",
          "  factor      NUMBER NOT NULL,",
          "  fetched_at  TIMESTAMP DEFAULT ON NULL SYS_EXTRACT_UTC(SYSTIMESTAMP) NOT NULL,",
          "  content     BLOB NOT NULL",
          ")",
          "ANNOTATIONS (Description 'ESA WorldCover 2021 over the surface temperature raster as NumPy array (staging)');",
          "",
          "DECLARE",
          "  c_item   CONSTANT VARCHAR2(100) := 'ESA_WorldCover_10m_2021_v200_N45E015';   -- 3 x 3 degree tile with Zagreb",
          "  c_factor CONSTANT PLS_INTEGER   := 3;                                          -- 10 m cells per 30 m pixel and axis",
          "  c_amp    CONSTANT VARCHAR2(1)   := CHR(38);                                    -- ampersand, avoids substitution prompts",
          "  l_raster SDO_GEORASTER;",
          "  l_ext    SDO_GEOMETRY;",
          "  l_dims   SDO_NUMBER_ARRAY;",
          "  l_minx   NUMBER;",
          "  l_miny   NUMBER;",
          "  l_maxx   NUMBER;",
          "  l_maxy   NUMBER;",
          "  l_url    VARCHAR2(1000);",
          "",
          "  FUNCTION num (p IN NUMBER) RETURN VARCHAR2 IS",
          "  BEGIN",
          "    RETURN TO_CHAR(p, 'TM9', 'NLS_NUMERIC_CHARACTERS=''.,''');",
          "  END num;",
          "BEGIN",
          "  -- Same grid as the surface temperature raster and ZG_LST_PIXELS, 3 times finer",
          "  SELECT raster INTO l_raster FROM zg_lst_vw;",
          "  l_ext  := SDO_GEOR.generateSpatialExtent(l_raster);                         -- outer pixel edges",
          "  l_dims := SDO_GEOR.getSpatialDimSizes(l_raster);                            -- rows, columns",
          "  l_minx := SDO_GEOM.SDO_MIN_MBR_ORDINATE(l_ext, 1);",
          "  l_maxx := SDO_GEOM.SDO_MAX_MBR_ORDINATE(l_ext, 1);",
          "  l_miny := SDO_GEOM.SDO_MIN_MBR_ORDINATE(l_ext, 2);",
          "  l_maxy := SDO_GEOM.SDO_MAX_MBR_ORDINATE(l_ext, 2);",
          "",
          "  l_url := 'https://planetarycomputer.microsoft.com/api/data/v1/item/bbox/'",
          "        || num(l_minx) || ',' || num(l_miny) || ',' || num(l_maxx) || ',' || num(l_maxy) || '/'",
          "        || (l_dims(2) * c_factor) || 'x' || (l_dims(1) * c_factor) || '.npy'",
          "        || '?collection=esa-worldcover' || c_amp || 'item=' || c_item",
          "        || c_amp || 'assets=map' || c_amp || 'resampling=nearest';",
          "",
          "  INSERT INTO zg_worldcover_files (source_url, minx, miny, maxx, maxy, lst_rows, lst_cols, factor, content)",
          "  VALUES (l_url, l_minx, l_miny, l_maxx, l_maxy, l_dims(1), l_dims(2), c_factor,",
          "          DBMS_CLOUD.GET_OBJECT(credential_name => NULL, object_uri => l_url));",
          "  COMMIT;",
          "END;",
          "/"
        ],
        "selectedVisualization" : "raw",
        "visualizationConfig" : null,
        "hideCode" : false,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
