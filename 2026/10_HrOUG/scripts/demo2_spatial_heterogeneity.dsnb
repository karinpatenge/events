        "title" : "Check result",
        "hasTitle" : true,
        "message" : [
          "%sql",
          "",
          "-- Expected: 1320 rows x 1209 columns, factor 3, about 28.7 MB (land cover class and mask, 3960 x 3627 cells each)",
          "SELECT id, lst_rows, lst_cols, factor, DBMS_LOB.GETLENGTH(content) AS bytes, fetched_at FROM zg_worldcover_files"
        ],
        "selectedVisualization" : "table",
        "visualizationConfig" : null,
        "hideCode" : false,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
        "enabled" : true,
        "forms" : "[]",
        "result" : {
          "interpreter" : "sql.low",
          "taskStatus" : "SUCCESS",
          "status" : "SUCCESS",
          "results" : [
            {
              "message" : "ID\tLST_ROWS\tLST_COLS\tFACTOR\tBYTES\tFETCHED_AT\n1\t1320\t1209\t3\t28725968\t2026-10-15 23:03:49.125861\n",
              "type" : "TABLE"
            }
          ],
          "forms" : "[]"
        },
        "relations" : [ ],
        "dynamicFormParams" : "{}"
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : "Land cover shares per 30 m pixel and per H3 cell",
        "hasTitle" : true,
        "message" : [
          "%python",
          "",
          "# ESA WorldCover classes grouped; BUILT (built-up, bare) is the reference category of the regression",
          "GROUPS = {'CANOPY': [10], 'GREEN': [20, 30, 40, 90, 95, 100], 'WATER': [80], 'BUILT': [50, 60]}",
          "",
          "cur = oml.cursor()",
          "cur.execute('SELECT content, minx, miny, maxx, maxy, lst_rows, lst_cols, factor '",
          "            'FROM zg_worldcover_files ORDER BY fetched_at DESC FETCH FIRST 1 ROW ONLY')",
          "blob, minx, miny, maxx, maxy, rows, cols, f = cur.fetchone()",
          "minx, miny, maxx, maxy = float(minx), float(miny), float(maxx), float(maxy)",
          "rows, cols, f = int(rows), int(cols), int(f)",
          "classes = np.load(io.BytesIO(blob.read()), allow_pickle=False)[0]       # band 0: class, band 1: mask",
          "assert classes.shape == (rows * f, cols * f), classes.shape",
          "",
          "# Share of each group per 30 m pixel of the surface temperature raster (f x f cells of 10 m), in percent",
          "share = {g: np.isin(classes, c).reshape(rows, f, cols, f).mean(axis=(1, 3)) * 100 for g, c in GROUPS.items()}",
          "",
          "# Valid surface temperature pixels (centres) and their H3 cell at resolution 9",
          "cur.arraysize = 50000",
          "cur.execute('SELECT lon, lat, RAWTOHEX(SDO_UTIL.H3_KEY(lon, lat, 9)) FROM zg_lst_pixels')",
          "px = pd.DataFrame(cur.fetchall(), columns=['LON', 'LAT', 'H3_ID'])",
          "cur.close()",
          "",
          "dx, dy = (maxx - minx) / cols, (maxy - miny) / rows",
          "r = np.clip(((maxy - px['LAT'].to_numpy(dtype=float)) / dy).astype(int), 0, rows - 1)",
          "c = np.clip(((px['LON'].to_numpy(dtype=float) - minx) / dx).astype(int), 0, cols - 1)",
          "for g in GROUPS:",
          "    px[g + '_PCT'] = share[g][r, c]",
          "",
          "landcover = px.groupby('H3_ID')[[g + '_PCT' for g in GROUPS]].mean().round(1).reset_index()",
          "",
          "# Staging table for the SQL paragraph",
          "try:",
          "    oml.drop(table='ZG_H3_LANDCOVER_STAGE')",
          "except Exception:",
          "    pass",
          "oml.create(landcover, table='ZG_H3_LANDCOVER_STAGE')",
          "",
          "# Expected: 711,436 pixels; mean shares about 53 % canopy, 29 % green, 1 % water, 16 % built-up",
          "print(f\"{len(px):,} pixels in {len(landcover):,} H3 cells; mean shares per pixel: \"",
          "      + ', '.join(f\"{g.lower()} {px[g + '_PCT'].mean():.1f} %\" for g in GROUPS))"
        ],
        "selectedVisualization" : "raw",
        "visualizationConfig" : null,
        "hideCode" : false,
