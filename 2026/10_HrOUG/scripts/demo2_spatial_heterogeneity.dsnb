          "               FROM zet_stops_lisa l JOIN zet_stops s ON s.stop_id = l.stop_id''')",
          "stops = pd.DataFrame(cur.fetchall(), columns=['STOP_ID', 'STOP_NAME', 'TRANSPORT_MODE', 'WEEKDAY_DEPARTURES', 'H3_ID', 'LST_C', 'QUADRANT'])",
          "cur.close()",
          "",
          "local = pd.DataFrame({'H3_ID': cells_gdf['H3_ID'].to_numpy(),",
          "                      'BUILT_PCT': cells_gdf['BUILT_PCT'].to_numpy(),",
          "                      'COOLING_10PP_C': cooling_10pp})",
          "stops = stops.merge(local, on='H3_ID', how='inner')",
          "stops['CANOPY_GAIN_PP'] = np.minimum(15, stops['BUILT_PCT'])",
          "stops['COOLING_C'] = (stops['COOLING_10PP_C'] / 10 * stops['CANOPY_GAIN_PP']).round(2)",
          "",
          "hot = stops[stops['QUADRANT'] == 1].sort_values('COOLING_C', ascending=False)",
