        "width" : 12,
        "title" : "Plot the local cooling effect of tree canopy",
        "hasTitle" : true,
        "message" : [
          "%python",
          "",
          "betas = np.asarray(gwr.betas)                             # n x 3: intercept, canopy, green",
          "cooling_10pp = -10 * betas[:, 1]                          # °C cooler per +10 pp canopy instead of built-up area",
          "",
          "global_cooling = -10 * np.ravel(ols.betas)[1]",
          "q = np.percentile(cooling_10pp, [5, 25, 50, 75, 95])",
          "print(f\"Cooling per +10 pp canopy: global OLS {global_cooling:.2f} °C; local (GWR) 5 % {q[0]:.2f}, \"",
          "      f\"25 % {q[1]:.2f}, median {q[2]:.2f}, 75 % {q[3]:.2f}, 95 % {q[4]:.2f} °C\")",
          "",
          "fig, ax = plt.subplots(1, 1, figsize=(12, 12))",
          "ax.set_title('°C cooler per +10 percentage points of tree canopy (local GWR coefficient)', fontsize=16)",
          "X.plot(ax=ax, column=cooling_10pp, cmap=plt.get_cmap('YlGnBu'), legend=True, linewidth=0, with_basemap=True, alpha=0.8)"
