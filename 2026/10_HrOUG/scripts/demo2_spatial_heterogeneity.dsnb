          "%python",
          "",
          "X_model = X[[TARGET] + FEATURES + ['geometry']]",
          "",
          "ols_pipe = SpatialPipeline([('regression', OLSRegressor(KNNWeightsDefinition(k=6)))])",
          "ols_pipe.fit(X_model, TARGET)",
          "ols = ols_pipe.named_steps['regression']",
          "print(ols.summary)"
        ],
