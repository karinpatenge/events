        "title" : "Train model",
        "hasTitle" : true,
        "message" : [
          "%python",
          "",
          "ols_pipeline = SpatialPipeline([('scale', RobustScaler()), ",
          "                                ('regression', OLSRegressor(KNNWeightsDefinition(k=10)))])",
          "ols_pipeline.fit(X_train, \"MEDIAN_INCOME\")"
        ],
