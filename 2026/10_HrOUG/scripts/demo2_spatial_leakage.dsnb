          "taskStatus" : "SUCCESS",
          "status" : "SUCCESS",
          "results" : [
            {
              "message" : "<h6 id=\"prepare-the-city-districts\">Prepare the city districts</h6>\n<p>The City of Zagreb publishes its 17 city districts (gradske četvrti) as a shapefile on the national open data portal, in HTRS96 / Croatia TM (EPSG:3765).</p>\n<ol>\n<li>The database downloads the ZIP with <code>DBMS_CLOUD.GET_OBJECT</code> (public URL, no credential).</li>\n<li>Python reads the shapefile from the ZIP, orients the polygon rings for Oracle Spatial and writes <code>ZG_DISTRICTS</code> in WGS84 (SRID 4326), like the other tables of the demo.</li>\n<li>SQL adds annotations for Select AI and drops the staging table.</li>\n</ol>\n<p>Run this section once. The analysis starts at <em>Prepare the data</em>.</p>\n",
              "type" : "HTML"
            }
          ],
          "forms" : "[]"
        },
        "relations" : [ ],
        "dynamicFormParams" : "{}"
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : "Store the city district shapefile (ZIP) in a staging table",
        "hasTitle" : true,
        "message" : [
          "%script",
          "",
          "DROP TABLE IF EXISTS zg_district_files PURGE;",
          "",
          "CREATE TABLE zg_district_files (",
          "  id          INTEGER GENERATED ALWAYS AS IDENTITY (START WITH 1 INCREMENT BY 1 CACHE 1000 MAXVALUE 9999999999)",
          "              CONSTRAINT zg_district_files_pk PRIMARY KEY,",
          "  source_url  VARCHAR2(400) NOT NULL,",
          "  fetched_at  TIMESTAMP DEFAULT ON NULL SYS_EXTRACT_UTC(SYSTIMESTAMP) NOT NULL,",
          "  content     BLOB NOT NULL",
          ")",
          "ANNOTATIONS (Description 'City districts of Zagreb as downloaded (shapefile in a ZIP, staging)');",
          "",
          "DECLARE",
          "  -- Grad Zagreb: Gradske četvrti - prostorna jedinica mjesne samouprave (data.gov.hr), public URL, no credential",
          "  c_url CONSTANT VARCHAR2(400) := 'https://data.zagreb.hr/dataset/9c52e229-09bf-4569-8e01-37f338070d02'",
          "                                  || '/resource/f2406ad9-34bf-4235-aa24-d71a08ae2863/download/rpj_gc.zip';",
          "BEGIN",
          "  INSERT INTO zg_district_files (source_url, content)",
          "  VALUES (c_url, DBMS_CLOUD.GET_OBJECT(credential_name => NULL, object_uri => c_url));",
          "  COMMIT;",
          "END;",
          "/"
        ],
        "selectedVisualization" : "raw",
        "visualizationConfig" : null,
        "hideCode" : false,
        "hideResult" : false,
