        "result" : {
          "interpreter" : "md.low",
          "taskStatus" : "SUCCESS",
          "status" : "SUCCESS",
          "results" : [
            {
              "message" : "<h6 id=\"prepare-the-data\">Prepare the data</h6>\n<ul>\n<li><strong>Label <code>HEAT_CRITICAL</code>:</strong> 1 for the hottest fifth of the H3 cells (surface temperature at or above the 80th percentile of the city), else 0. The threshold is a fixed definition for the whole city.</li>\n<li><strong>Features:</strong> <code>CANOPY_PCT</code>, <code>GREEN_PCT</code>, <code>WATER_PCT</code>; built-up area is the reference category. SLX adds their spatial lag: the average over the 18 nearest cells, about two H3 rings or 600 m around the cell.</li>\n<li><strong>District:</strong> each cell gets the district that contains its centre. Cells in Novi Zagreb - istok and Novi Zagreb - zapad form the held-out area.</li>\n</ul>\n",
              "type" : "HTML"
            }
          ],
          "forms" : "[]"
        },
        "relations" : [ ],
        "dynamicFormParams" : "{}"
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : "Load the H3 cells, label the heat-critical cells and assign the districts",
        "hasTitle" : true,
        "message" : [
          "%python",
          "",
          "cells_sdf = SpatialDataFrame.create(DBSpatialDataset(table='ZG_H3_FEATURES', spatial_column='GEOM'))",
          "cells_sdf = cells_sdf[['H3_ID', 'LST_C'] + FEATURES + ['geometry']]",
          "X = cells_sdf.to_crs(ANALYSIS_CRS)                          # same row order as cells_sdf",
          "cells_gdf = X.as_geodataframe().reset_index(drop=True)",
          "",
          "# Label: hottest fifth of the city",
          "threshold = np.percentile(cells_gdf['LST_C'], 80)",
          "cells_gdf[TARGET] = (cells_gdf['LST_C'] >= threshold).astype(int)",
          "",
          "# District of each cell: the district polygon that contains the cell centre",
          "districts_gdf = SpatialDataFrame.create(DBSpatialDataset(table='ZG_DISTRICTS')).to_crs(ANALYSIS_CRS).as_geodataframe()",
          "centres = gpd.GeoDataFrame(geometry=cells_gdf.geometry.representative_point(), crs=cells_gdf.crs)",
          "joined = gpd.sjoin(centres, districts_gdf[['DISTRICT_NAME', 'geometry']], how='left', predicate='within')",
          "cells_gdf['DISTRICT_NAME'] = joined.groupby(level=0)['DISTRICT_NAME'].first().reindex(cells_gdf.index)",
          "held_out = cells_gdf['DISTRICT_NAME'].isin(HELD_OUT).to_numpy()",
          "",
          "model_gdf = cells_gdf[FEATURES + [TARGET, 'geometry']]",
          "y_all = cells_gdf[TARGET].to_numpy()",
          "print(f\"{len(cells_gdf):,} H3 cells; heat-critical: surface temperature >= {threshold:.1f} °C\")",
          "print(f\"Heat-critical share: whole city {y_all.mean():.0%}, Novi Zagreb {y_all[held_out].mean():.0%} \"",
          "      f\"({held_out.sum():,} cells), rest of the city {y_all[~held_out].mean():.0%}\")",
          "z.show(cells_gdf.groupby('DISTRICT_NAME').agg(CELLS=('H3_ID', 'size'), MEAN_LST_C=('LST_C', 'mean'),",
          "                                              HEAT_CRITICAL_SHARE=(TARGET, 'mean'), CANOPY_PCT=('CANOPY_PCT', 'mean'))",
          "                .round(2).sort_values('MEAN_LST_C', ascending=False).reset_index())"
        ],
