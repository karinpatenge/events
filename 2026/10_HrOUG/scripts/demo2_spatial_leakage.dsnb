          "%python",
          "",
          "pred_held_out = np.full(len(cells_gdf), np.nan)",
          "pred_held_out[held_out] = p_nz",
          "",
          "cells_out = cells_sdf[['H3_ID', 'LST_C', 'geometry']]",
          "for name, values in [('DISTRICT_NAME', cells_gdf['DISTRICT_NAME'].fillna('').to_numpy()),",
          "                     (TARGET, y_all), ('HELD_OUT', held_out.astype(int)), ('PRED_HELD_OUT', pred_held_out)]:",
          "    cells_out = cells_out.add_column(name, values)",
          "cells_out.write(DBSpatialDataset(table='ZG_H3_SLX'), if_exists='replace',",
          "                create_spatial_metadata=True, create_spatial_index=True)",
          "",
          "slx_all = SLXClassifier(spatial_weights_definition=KNNWeightsDefinition(k=K), random_state=random_state,",
          "                        balance_method='random')",
          "slx_all.fit(SpatialDataFrame.from_geodataframe(model_gdf), TARGET, column_ids=FEATURES)",
          "oml.ds.save(objs={'zg_slx_model': slx_all}, name='zg_heat_slx',",
          "            description=f'Zagreb heat (HrOUG 2026): SLX classifier for heat-critical H3 cells (LST >= {threshold:.1f} °C)',",
          "            overwrite=True)",
