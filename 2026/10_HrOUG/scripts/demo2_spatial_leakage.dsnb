        "message" : [
          "%md",
          "",
          "###### Prepare the data",
          "",
          "* **Label `HEAT_CRITICAL`:** 1 for the hottest fifth of the H3 cells (surface temperature at or above the 80th percentile of the city), else 0. The threshold is a fixed definition for the whole city.",
          "* **Features:** `CANOPY_PCT`, `GREEN_PCT`, `WATER_PCT`; built-up area is the reference category. SLX adds their spatial lag: the average over the 18 nearest cells, about two H3 rings or 600 m around the cell.",
          "* **District:** each cell gets the district that contains its centre. Cells in Novi Zagreb - istok and Novi Zagreb - zapad form the held-out area."
        ],
        "selectedVisualization" : "html",
        "visualizationConfig" : null,
        "hideCode" : true,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
