        "hasTitle" : true,
        "message" : [
          "%python",
          "",
          "import os",
          "import tempfile",
          "import numpy as np",
          "import pandas as pd",
          "import geopandas as gpd",
          "import matplotlib.pyplot as plt",
          "from matplotlib.colors import ListedColormap",
          "from shapely.geometry import MultiPolygon",
          "from shapely.geometry.polygon import orient",
          "import sklearn.metrics as metrics",
          "from sklearn.linear_model import LogisticRegression",
          "import warnings",
          "warnings.filterwarnings('ignore')",
          "pd.options.mode.chained_assignment = None",
          "pd.options.display.max_columns = None",
          "",
          "# Reproducibility",
          "random_state = 456",
          "",
          "import oml",
          "",
          "# Spatial AI imports",
          "from oraclesai import SpatialDataFrame, DBSpatialDataset",
          "from oraclesai.classification import SLXClassifier",
          "from oraclesai.weights import KNNWeightsDefinition",
          "from oraclesai import enable_geodataframes",
          "enable_geodataframes(z)",
          "",
          "# Distances need projected coordinates: HTRS96 / Croatia TM, in metres",
          "ANALYSIS_CRS = 'epsg:3765'",
          "",
          "# Label, features and neighbourhood",
          "TARGET = 'HEAT_CRITICAL'                                   # 1: among the hottest fifth of the cells",
          "FEATURES = ['CANOPY_PCT', 'GREEN_PCT', 'WATER_PCT']        # built-up area is the reference category",
