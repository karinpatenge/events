          "results" : [
            {
              "message" : "ID\tSOURCE_URL\tFETCHED_AT\tBYTES\n1\thttps://data.zagreb.hr/dataset/9c52e229-09bf-4569-8e01-37f338070d02/resource/f2406ad9-34bf-4235-aa24-d71a08ae2863/download/rpj_gc.zip\t2026-10-15 23:14:18.164907\t245497\n",
