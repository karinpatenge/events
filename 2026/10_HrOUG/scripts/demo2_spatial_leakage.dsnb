      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : "Read the shapefile and write ZG_DISTRICTS",
        "hasTitle" : true,
        "message" : [
          "%python",
          "",
          "cur = oml.cursor()",
          "cur.execute('SELECT content FROM zg_district_files ORDER BY fetched_at DESC FETCH FIRST 1 ROW ONLY')",
          "content = cur.fetchone()[0].read()",
          "cur.close()",
          "",
          "# The shapefile (RPJ_GC.*) sits at the root of the ZIP; its attributes are encoded in Windows-1250",
          "with tempfile.TemporaryDirectory() as tmp:",
          "    path = os.path.join(tmp, 'rpj_gc.zip')",
          "    with open(path, 'wb') as f:",
          "        f.write(content)",
          "    raw = gpd.read_file(f'zip://{path}', encoding='cp1250')",
          "",
          "",
          "def ccw(geom):",
          "    \"\"\"Valid polygon with exterior rings counterclockwise and holes clockwise, as Oracle Spatial expects",
          "    (shapefiles store the rings the other way round).\"\"\"",
          "    if not geom.is_valid:",
          "        geom = geom.buffer(0)",
          "    if geom.geom_type == 'Polygon':",
          "        return orient(geom, 1.0)",
          "    return MultiPolygon([orient(p, 1.0) for p in geom.geoms])",
          "",
          "",
          "print(f\"{(~raw.is_valid).sum()} of {len(raw)} district polygons repaired\")",
          "districts = gpd.GeoDataFrame({",
          "    'DISTRICT_CODE': raw['JMS_MB'],",
          "    'DISTRICT_NAME': raw['JMS_IME'],",
          "    'AREA_KM2':      (raw.to_crs(ANALYSIS_CRS).area / 1e6).round(2),",
          "}, geometry=raw.to_crs('epsg:4326').geometry.apply(ccw), crs='epsg:4326')",
          "",
          "SpatialDataFrame.from_geodataframe(districts).write(DBSpatialDataset(table='ZG_DISTRICTS'), if_exists='replace',",
          "                                                    create_spatial_metadata=True, create_spatial_index=True)",
          "print(f\"written: ZG_DISTRICTS, {len(districts)} districts, {districts['AREA_KM2'].sum():.0f} km²\")"
        ],
        "selectedVisualization" : "raw",
        "visualizationConfig" : null,
        "hideCode" : false,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
        "enabled" : true,
