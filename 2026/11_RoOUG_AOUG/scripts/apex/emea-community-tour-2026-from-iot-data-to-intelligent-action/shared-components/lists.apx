list navigation-bar (
    name: Navigation Bar

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry asset (
        label: Asset
        icon {
            imageIconCssClasses: fa-gear
        }
        layout {
            sequence: 40
            parentEntry: @home
        }
        isCurrent {
            type: pages
            pages: 4
        }
        link {
            target: {
                page: 4
            }
        }
    )

    entry assistant (
        label: Assistant
        icon {
            imageIconCssClasses: fa-chatbot
        }
        layout {
            sequence: 50
            parentEntry: @home
        }
        isCurrent {
            type: pages
            pages: 5
        }
        link {
            target: {
                page: 5
            }
        }
    )

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry incident (
        label: Incident
        icon {
            imageIconCssClasses: fa-alert
        }
        layout {
            sequence: 30
            parentEntry: @home
        }
        isCurrent {
            type: pages
            pages: 3
        }
        link {
            target: {
                page: 3
            }
        }
    )

    entry my-tasks (
        label: Tasks
        icon {
            imageIconCssClasses: fa-tasks
        }
        layout {
            sequence: 70
            parentEntry: @home
        }
        isCurrent {
            type: pages
            pages: 7
        }
        link {
            target: {
                page: 7
            }
        }
    )

    entry network (
        label: Network
        icon {
            imageIconCssClasses: fa-network-hub
        }
        layout {
            sequence: 20
            parentEntry: @home
        }
        isCurrent {
            type: pages
            pages: 2
        }
        link {
            target: {
                page: 2
            }
        }
    )

    entry work-orders (
        label: Work orders
        icon {
            imageIconCssClasses: fa-wrench
        }
        layout {
            sequence: 60
            parentEntry: @home
        }
        isCurrent {
            type: pages
            pages: 9
        }
        link {
            target: {
                page: 9
            }
        }
    )

)

