customAttribute defaults_for_modes (
    apexlangName: defaultValuesForModes
    attribute: 94
    name: Default Values for Modes
    type: checkboxes
    appearance {
        attributeGroup: @appearance
        sequence: 849
    }
    default {
        value: interactionActive:fitToScreenActive:stickyActive:evolutionActive
    }
    help {
        helpText: Specifies the default state of mode options(Select - Move/Zoom, Fit to Screen, Sticky mode, Evolution).
    }

    entry enableEvolutionSetting (
        sequence: 40
        display: Enable Evolution Setting
        return: evolutionActive
        help {
            helpText: Specifies the default state of the 'Evolution' toggle button in the toolbar. True activates the button and false deactivates it.
        }
    )

    entry enableFitToScreen (
        sequence: 20
        display: Enable Fit to Screen
        return: fitToScreenActive
        help {
            helpText: Specifies the default state of the 'Fit to Screen' toggle button in the toolbar. True activates the button and false deactivates it.
        }
    )

    entry enableInteraction (
        sequence: 10
        display: Enable Interaction
        return: interactionActive
        help {
            helpText: Specifies the default state of the 'Select - Move/Zoom' toggle button in the toolbar. True activates 'Select' mode and false switches to 'Move/Zoom' mode.
        }
    )

    entry enableStickyMode (
        sequence: 30
        display: Enable Sticky Mode
        return: stickyActive
        help {
            helpText: Specifies the default state of the 'Sticky mode' toggle button in the toolbar. True activates the button and false deactivates it.
        }
    )

)

