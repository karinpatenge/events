customAttribute force_alphadecay (
    apexlangName: alphaDecay
    attribute: 20
    name: Alpha Decay
    type: number
    appearance {
        attributeGroup: @layout
        sequence: 42
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: =
        value: force
    }
    help {
        helpText: alphaDecay controls the rate at which the simulation's internal alpha value, which influences node movement, decreases over time, gradually stabilizing the force layout. Default is 0.01.
    }
)

