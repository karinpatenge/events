customAttribute hierarchical_ranker (
    apexlangName: ranker
    attribute: 30
    name: Ranker
    type: selectList
    appearance {
        attributeGroup: @layout
        sequence: 43
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: =
        value: hierarchical
    }
    help {
        helpText: Specifies the type of algorithm used to rank the vertices.
    }

    entry longestPath (
        sequence: 30
        display: Longest Path
        return: longest-path
        help {
            helpText:
                ```
                Vertices are pushed to the lowest layer possible, leaving the bottom ranks wide and leaving edges
                    longer than necessary.
                ```
        }
    )

    entry networkSimplex (
        sequence: 10
        display: Network Simplex
        return: network-simplex
        help {
            helpText: The network simplex algorithm assigns ranks to each vertex in the input graph and iteratively
        }
    )

    entry tightTree (
        sequence: 20
        display: Tight Tree
        return: tight-tree
        help {
            helpText:
                ```
                Constructs a spanning tree with tight edges and adjust the ranks of the input vertex to achieve
                    this. A tight edge is one that is has a length that matches its `minlen` attribute.
                ```
        }
    )

)

