customAttribute attribute_01 (
    apexlangName: settings
    attribute: 1
    name: Settings
    scope: app
    type: textarea
    appearance {
        sequence: 10
    }
    help {
        helpText: Settings from template are configured here.
    }
)

customAttribute attribute_02 (
    apexlangName: basestyles
    attribute: 2
    name: BaseStyles
    scope: app
    type: textarea
    appearance {
        sequence: 20
    }
    help {
        helpText: Settings.BaseStyles from template are configured here.
    }
)

customAttribute attribute_02 (
    apexlangName: generalSettings
    attribute: 2
    name: General Settings
    type: textarea
    appearance {
        attributeGroup: @advanced
        sequence: 120
    }
    help {
        helpText: Settings of the graph component like pageSize, legendWidth etc can be provided here.
    }
    examples {
        examples:
            ```
            {
              "legendWidth": 300
            }
            
            {
                pageSize: 10,
                groupEdges: true,
                legendWidth: 200
              }
            ```
    }
)

customAttribute attribute_04 (
    apexlangName: layout
    attribute: 4
    name: Layout
    type: selectList
    appearance {
        attributeGroup: @layout
        sequence: 40
    }
    help {
        helpText: This determines how nodes are positioned in the visual structure of the graph.
    }

    entry circle (
        sequence: 10
        display: Circle
        return: circle
    )

    entry concentric (
        sequence: 20
        display: Concentric
        return: concentric
    )

    entry force (
        sequence: 30
        display: Force
        return: force
    )

    entry geographical (
        sequence: 70
        display: Geographical
        return: geographical
        help {
            helpText: Applies geographical layout to graph elements
        }
    )

    entry grid (
        sequence: 40
        display: Grid
        return: grid
    )

    entry hierarchical (
        sequence: 50
        display: Hierarchical
        return: hierarchical
    )

    entry radial (
        sequence: 60
        display: Radial
        return: radial
    )

)

customAttribute attribute_05 (
    apexlangName: groupEdges
    attribute: 5
    name: Group Edges
    type: yesNo
    appearance {
        attributeGroup: @appearance
        sequence: 150
    }
    help {
        helpText: When enabled, multiple edges between the same source and target vertex will be grouped together in the graph. The grouped edges will be shown as a single edge with a number on it, indicating how many edges have been grouped.
    }
)

customAttribute attribute_06 (
    apexlangName: displaySize
    attribute: 6
    name: Display Size
    type: integer
    appearance {
        sequence: 60
    }
    default {
        value: 100
    }
    help {
        helpText: Determines how many elements are shown in the graph.
    }
)

customAttribute attribute_07 (
    apexlangName: vertexCaption
    attribute: 7
    name: Vertex Caption
    appearance {
        attributeGroup: @caption
        sequence: 151
    }
    help {
        helpText: The property from the graph data that will be shown as a label beside each vertex in the graph.
    }
    examples {
        examples:
            ```
            If this attribute is assigned with the value <b>FirstName</b>, and if the graph data has a vertex with {'FirstName': 'Mark', 'LastName', 'Taylor'}, the corresponding vertex's label will read 'Mark' in the graph.<br>
            Note: There's no need to include additional quotes when specifying the attribute name or values.
            ```
    }
)

customAttribute attribute_08 (
    apexlangName: edgeCaption
    attribute: 8
    name: Edge Caption
    appearance {
        attributeGroup: @caption
        sequence: 152
    }
    help {
        helpText: The property from the graph data that will be shown as a label beside each edge of the graph.
    }
    examples {
        examples:
            ```
            If this attribute is assigned with the value <b>Id</b>, and if the graph data has a edge with {'Id': 100}, the corresponding edge's label will read '100' in the graph.<br>
            Note: There's no need to include additional quotes when specifying the attribute name or values.
            ```
    }
)

customAttribute attribute_09 (
    apexlangName: maximumCaptionLength
    attribute: 9
    name: Maximum Caption Length
    type: integer
    appearance {
        attributeGroup: @caption
        sequence: 153
    }
    help {
        helpText: Number of characters up to which Vertex and Edge labels will be shown in the graph.
    }
)

customAttribute attribute_10 (
    apexlangName: display
    attribute: 10
    name: Display
    type: checkboxes
    appearance {
        attributeGroup: @appearance
        sequence: 850
    }
    default {
        value: modes:exploration
    }
    help {
        helpText:
            ```
            This attribute contains check boxes - 'Modes' and 'Exploration'.
            'Modes' checkbox when checked, shows the modes toolbar in the graph, that allows functions like 'Move/Zoom', 'Fit to Screen' etc. 
            'Exploration' checkbox when checked, shows the exploration toolbar in the graph, that allows functions like 'Group', 'Ungroup' etc.
            ```
    }

    entry exploration (
        sequence: 20
        display: Exploration
        return: exploration
    )

    entry modes (
        sequence: 10
        display: Modes
        return: modes
    )

)

customAttribute attribute_11 (
    apexlangName: expand
    attribute: 11
    name: Expand
    type: javaScriptCode
    appearance {
        attributeGroup: @callbacks
        sequence: 110
    }
    help {
        helpText: Javascript to expand a node and fetch it's neighbors can be specified here.
    }
)

customAttribute attribute_12 (
    apexlangName: fetchActions
    attribute: 12
    name: Fetch Actions
    type: javaScriptCode
    appearance {
        attributeGroup: @callbacks
        sequence: 120
    }
    help {
        helpText: FetchActions callback function: Javascript that retrieves the saved state of the graph can be provided here.
    }
    examples {
        examples:
            ```
            Javascript:
            const actions = await apex.server.process('Fetch',null, {dataType: 'text'});
                try {
                    return JSON.parse(actions);
                } catch (error) {
                    return [];
                }
            
            
            AJAX callback - 'Fetch' defined in the APEX processes tab:
            DECLARE
                data clob;
            BEGIN
                SELECT JSON_ARRAYAGG(action FORMAT JSON ORDER BY ID ASC returning clob) INTO data FROM EBA_GRAPHVIZ_GRAPH_ACTION WHERE USER_ID = v('APP_USER');
                htp.p(data);
            END;
            ```
    }
)

customAttribute attribute_13 (
    apexlangName: persist
    attribute: 13
    name: Persist
    type: javaScriptCode
    appearance {
        attributeGroup: @callbacks
        sequence: 130
    }
    help {
        helpText: Javascript that persists the saved state of the graph can be provided here.
    }
    examples {
        examples:
            ```
            Javascript:
            
                await apex.server.process('Persist', {
                    x01: JSON.stringify(action)
                }, {dataType: 'text'});
            
            
            AJAX callback - 'Fetch' defined in the APEX processes tab:
            
            INSERT INTO EBA_GRAPHVIZ_GRAPH_ACTION(ACTION, USER_ID) VALUES(apex_application.g_x01, v('APP_USER'));
            ```
    }
)

