page 4 (
    name: Asset
    alias: ASSET
    title: Asset
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            setInterval(function () {
              if (document.hidden) { return; }                       // tab in the background
              ["chart6h", "anomalies4"].forEach(function (id) {
                var r = apex.region(id);
                if (!r || !r.element.is(":visible")) { return; }     // missing or collapsed region
                try { r.refresh(); } catch (e) { apex.debug.warn("refresh " + id + ": " + e.message); }
              });
            }, 30000);
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region asset (
        name: Asset
        type: staticContent
        layout {
            sequence: 10
            slot: body
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region details (
        name: Details
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT s.name                         AS "Name",
                       s.type_name                    AS "Type",
                       s.district                     AS "District",
                       a.equipment                    AS "Equipment",
                       a.rated_kw                     AS "Rated power (kW)",
                       a.install_year                 AS "Installed",
                       s.criticality                  AS "Criticality (1-5)",
                       s.health_status                AS "Health",
                       s.health_reason                AS "Reason",
                       s.health_color                 AS health_color
                FROM   dh_asset_status_v s
                JOIN   dh_assets a ON a.asset_id = s.asset_id
                WHERE  s.asset_id = :P4_ASSET_ID
                ```
            pageItemsToSubmit: P4_ASSET_ID
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            columnSpan: 8
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/value-attribute-pairs-column
            templateOptions: [
                #DEFAULT#
                t-AVPList--leftAligned
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column "Criticality (1-5)" (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Criticality (1-5)
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
        )

        column District (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: District
            }
            layout {
                sequence: 30
            }
        )

        column Equipment (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Equipment
            }
            layout {
                sequence: 40
            }
        )

        column HEALTH_COLOR (
            reportColumnQueryId: 10
            derivedColumn: N
            type: hidden
            layout {
                sequence: 100
            }
        )

        column Health (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Health
            }
            layout {
                sequence: 80
            }
            columnFormatting {
                htmlExpression: <span style="color:#HEALTH_COLOR#; font-weight:bold">#Health#</span>
            }
        )

        column Installed (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Installed
                alignment: end
            }
            layout {
                sequence: 60
