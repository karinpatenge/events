    pageItem P4_METRIC (
        type: selectList
        label {
            label: Metric
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT m.display_name || ' (' || m.unit || ')' AS d, m.metric AS r
                FROM   dh_metrics m
                JOIN   dh_assets a ON a.asset_type = m.asset_type
                WHERE  a.asset_id = :P4_ASSET_ID
                ORDER  BY m.display_name
                ```
        }
        layout {
            sequence: 20
            region: @asset
            slot: regionBody
            alignment: left
        }
        appearance {
