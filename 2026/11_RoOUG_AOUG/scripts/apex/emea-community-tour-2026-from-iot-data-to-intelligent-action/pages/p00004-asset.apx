    region last-6-hours (
        name: Last 6 hours
        title: &P4_METRIC_NAME. (&P4_UNIT.) – last 6 hours
        type: chart
        layout {
            sequence: 30
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: chart6h
        }
        chart {
            type: line
        }
        chartLayout {
            height: 400
        }
        legend {
            position: bottom
        }

        series alarm-limit (
            name: Alarm limit (&P4_LIMIT_KIND.)
            execution {
                sequence: 30
            }
            source {
                type: sqlQuery
                sqlQuery: SELECT ts_local, TO_NUMBER(:P4_ALARM) AS value FROM dh_telemetry_recent_v WHERE asset_id = :P4_ASSET_ID AND metric = :P4_METRIC ORDER BY ts_local
                pageItemsToSubmit: [
                    P4_ASSET_ID
                    P4_METRIC
                    P4_WARN
                    P4_ALARM
                ]
            }
            columnMapping {
                label: TS_LOCAL
                value: VALUE
            }
            appearance {
                color: #c74634
            }
            line {
                style: dashed
            }
            marker {
                show: false
            }
        )

        series p4-metric-name (
            name: &P4_METRIC_NAME.
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery: SELECT ts_local, value FROM dh_telemetry_recent_v WHERE asset_id = :P4_ASSET_ID AND metric = :P4_METRIC ORDER BY ts_local
                pageItemsToSubmit: [
                    P4_ASSET_ID
                    P4_METRIC
                    P4_WARN
                    P4_ALARM
                ]
            }
            columnMapping {
                label: TS_LOCAL
                value: VALUE
            }
            appearance {
                color: #2c3e50
            }
            marker {
                show: false
            }
        )

        series warning-limit (
            name: Warning limit (&P4_LIMIT_KIND.)
            execution {
                sequence: 20
            }
            source {
                type: sqlQuery
                sqlQuery: SELECT ts_local, TO_NUMBER(:P4_WARN) AS value FROM dh_telemetry_recent_v WHERE asset_id = :P4_ASSET_ID AND metric = :P4_METRIC ORDER BY ts_local
                pageItemsToSubmit: [
                    P4_ASSET_ID
                    P4_METRIC
                    P4_WARN
                    P4_ALARM
                ]
            }
            columnMapping {
                label: TS_LOCAL
                value: VALUE
            }
