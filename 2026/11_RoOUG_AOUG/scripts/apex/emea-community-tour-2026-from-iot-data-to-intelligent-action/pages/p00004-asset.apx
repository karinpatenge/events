    pageItem P4_ASSET_ID (
        type: selectList
        label {
            label: Asset
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT asset_id || ' ' || name || ' (' || health_status || ')' AS d, asset_id AS r
                FROM   dh_assets
                WHERE  asset_type IN ('PUMP_STATION', 'SUBSTATION')
                ORDER  BY asset_id
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @asset
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
