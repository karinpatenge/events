    region last-7-days (
        name: Last 7 days
        title: &P4_METRIC_NAME. (&P4_UNIT.) – last 7 days, hourly average
        type: chart
        layout {
            sequence: 40
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: chart7d
        }
        chart {
            type: line
        }
        chartLayout {
            height: 400
        }
        legend {
            position: bottom
        }

        series alarm-limit (
            name: Alarm limit (&P4_LIMIT_KIND.)
            execution {
                sequence: 30
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT TRUNC(CAST(FROM_TZ(ts, 'UTC') AT LOCAL AS DATE), 'HH24') AS hour, TO_NUMBER(:P4_ALARM) AS value
                    FROM   dh_telemetry
                    WHERE  asset_id = :P4_ASSET_ID AND metric = :P4_METRIC
                    AND    ts > SYS_EXTRACT_UTC(SYSTIMESTAMP) - INTERVAL '7' DAY
                    GROUP  BY TRUNC(CAST(FROM_TZ(ts, 'UTC') AT LOCAL AS DATE), 'HH24')
                    ORDER  BY 1
                    ```
                pageItemsToSubmit: [
                    P4_ASSET_ID
                    P4_METRIC
                    P4_WARN
                    P4_ALARM
                ]
            }
            columnMapping {
                label: HOUR
                value: VALUE
            }
            appearance {
                color: #c74634
            }
            line {
                style: dashed
            }
            marker {
                show: false
            }
        )

        series p4-metric-name (
            name: &P4_METRIC_NAME.
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT TRUNC(CAST(FROM_TZ(ts, 'UTC') AT LOCAL AS DATE), 'HH24') AS hour, ROUND(AVG(value), 2) AS value
                    FROM   dh_telemetry
                    WHERE  asset_id = :P4_ASSET_ID AND metric = :P4_METRIC
                    AND    ts > SYS_EXTRACT_UTC(SYSTIMESTAMP) - INTERVAL '7' DAY
                    GROUP  BY TRUNC(CAST(FROM_TZ(ts, 'UTC') AT LOCAL AS DATE), 'HH24')
                    ORDER  BY 1
                    ```
            }
            columnMapping {
                label: HOUR
                value: VALUE
            }
            appearance {
                color: #2c3e50
            }
            marker {
                show: false
            }
        )

        series warning-limit (
            name: Warning limit (&P4_LIMIT_KIND.)
            execution {
                sequence: 20
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    -- Series 1: hourly average of the readings (local time)
                    SELECT TRUNC(CAST(FROM_TZ(ts, 'UTC') AT LOCAL AS DATE), 'HH24') AS hour, TO_NUMBER(:P4_WARN) AS value
                    FROM   dh_telemetry
                    WHERE  asset_id = :P4_ASSET_ID AND metric = :P4_METRIC
                    AND    ts > SYS_EXTRACT_UTC(SYSTIMESTAMP) - INTERVAL '7' DAY
                    GROUP  BY TRUNC(CAST(FROM_TZ(ts, 'UTC') AT LOCAL AS DATE), 'HH24')
                    ORDER  BY 1
                    ```
                pageItemsToSubmit: [
                    P4_ASSET_ID
                    P4_METRIC
                    P4_WARN
                    P4_ALARM
                ]
            }
            columnMapping {
                label: HOUR
                value: VALUE
            }
            appearance {
                color: #f0ab00
            }
            line {
                style: dashed
            }
            marker {
                show: false
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

