page 3 (
    name: Incident
    alias: INCIDENT
    title: Incident
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region analysis (
        name: Analysis
        type: staticContent
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region impact (
        name: Impact
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT jt.asset_name                                          AS "Asset",
                       jt.downstream_buildings                                AS "Buildings supplied",
                       jt.apartments                                          AS "Apartments supplied",
                       jt.cut_off                                             AS "Cold if it fails",
                       REPLACE(REPLACE(REPLACE(jt.critical, '["'), '"]'), '","', ', ') AS "Critical buildings affected"
                FROM   JSON_TABLE(agent_impact_analysis(:P3_ASSET_ID), '$'
                         COLUMNS (asset_name           VARCHAR2(100)  PATH '$.asset_name',
                                  downstream_buildings NUMBER         PATH '$.downstream_buildings',
                                  apartments           NUMBER         PATH '$.apartments',
                                  cut_off              NUMBER         PATH '$.if_asset_out_of_service.buildings_without_supply',
                                  critical             VARCHAR2(4000) FORMAT JSON PATH '$.if_asset_out_of_service.critical_buildings')) jt
                
                
                
                ```
            pageItemsToSubmit: P3_ASSET_ID
        }
        layout {
            sequence: 10
            parentRegion: @analysis
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/value-attribute-pairs-column
            templateOptions: [
                #DEFAULT#
                t-AVPList--fixedLabelLarge
                t-AVPList--leftAligned
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column "Apartments supplied" (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Apartments Supplied
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
        )

        column Asset (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Asset
            }
            layout {
                sequence: 10
            }
        )

        column "Buildings supplied" (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Buildings Supplied
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
        )

        column "Cold if it fails" (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Cold If It Fails
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
        )

        column "Critical buildings affected" (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Critical Buildings Affected
            }
            layout {
                sequence: 50
            }
        )

    )

    region incident (
        name: Incident
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region mitigation-options (
        name: Mitigation options
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT jt.action                                              AS "Option",
                       jt.still_cold                                          AS "Still cold",
                       REPLACE(REPLACE(REPLACE(jt.critical, '["'), '"]'), '","', ', ') AS "Critical still cold"
                FROM   JSON_TABLE(agent_impact_analysis(:P3_ASSET_ID), '$.mitigation_options[*]'
                         COLUMNS (action     VARCHAR2(200)  PATH '$.action',
                                  still_cold NUMBER         PATH '$.result_if_out_of_service.buildings_without_supply',
                                  critical   VARCHAR2(4000) FORMAT JSON PATH '$.result_if_out_of_service.critical_buildings')) jt
                
                ```
            pageItemsToSubmit: P3_ASSET_ID
        }
        layout {
            sequence: 20
            parentRegion: @analysis
            slot: subRegions
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/value-attribute-pairs-column
            templateOptions: [
                #DEFAULT#
                t-AVPList--leftAligned
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: No closed bypass valve leads into the affected area.
        }

        column "Critical still cold" (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Critical Still Cold
            }
            layout {
                sequence: 30
            }
        )

        column Option (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Option
            }
            layout {
                sequence: 10
            }
        )

        column "Still cold" (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Still Cold
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
        )

    )

    region root-cause-and-impact (
        name: Root cause and impact
        type: plugin/graphVisualization
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT *
                FROM   GRAPH_TABLE (
                        dh_network
                        MATCH (s IS asset WHERE s.asset_id = :P3_ASSET_ID)
                           -[e IS supplies WHERE e.valve_state = 'OPEN']->{1,4}
                           (b IS asset WHERE b.asset_type = 'BUILDING')
                        ONE ROW PER STEP (v1, st, v2)
                        COLUMNS (VERTEX_ID(v1) AS id_a, EDGE_ID(st) AS id_e, VERTEX_ID(v2) AS id_b))
                UNION
                SELECT *
                FROM   GRAPH_TABLE (
                        dh_network
                        MATCH (an IS anomaly WHERE an.status <> 'CLOSED') -[d IS detected_on]-> (s IS asset WHERE s.asset_id = :P3_ASSET_ID)
                        COLUMNS (VERTEX_ID(an) AS id_a, EDGE_ID(d) AS id_e, VERTEX_ID(s) AS id_b))
                UNION
                SELECT *
                FROM   GRAPH_TABLE (
                        dh_network
                        MATCH (w IS work_order WHERE w.status IN ('NEW', 'PLANNED', 'IN_PROGRESS')) -[t IS targets]-> (s IS asset WHERE s.asset_id = :P3_ASSET_ID)
                        COLUMNS (VERTEX_ID(w) AS id_a, EDGE_ID(t) AS id_e, VERTEX_ID(s) AS id_b))
                
                
                ```
            pageItemsToSubmit: P3_ASSET_ID
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: incident_graph
        }
        settings {
            displaySize: 100
            liveSearch: true
        }
        plugin-appearance {
            height2: 500
            sizeMode: compact
            edgeMarker: arrow
            tooltipMaxLength: 1000
            defaultValuesForModes: enableFitToScreen
            display: [
                modes
                exploration
            ]
            modesOptions: [
                interaction
                fitToScreen
                sticky
                evolution
            ]
            explorationOptions: [
                expand
                focus
                group
                ungroup
                drop
                undo
                redo
                reset
            ]
        }
        plugin-layout {
            layout: hierarchical
            rankDirection: topToBottom
            ranker: longestPath
        }
        plugin-advanced {
            baseStyles:
                ```
                {
                  "vertex": { "size": 10, "color": "#7FA65F",
                              "label": { "text": "${properties.ASSET_ID}", "angle": 270, "d": 4, "font": { "size": 20 }, "color": "#7FA65F" },
                              "border": { "color": "#FFFFFF", "width": 1 } },
                  "edge":   { "width": 2, "color": "#9B9B9B" }
                }
                ```
            ruleBasedStyles:
                ```
                [
                {"legendTitle":"Heat plant","component":"vertex","target":"vertex","stylingEnabled":true,"conditions":{"operator":"and","conditions":[{"property":"ASSET_TYPE","operator":"=","value":"PLANT"}]},"style":{"color":"#8E44AD","size":30,"icon":{"class":"fa-fire","color":"#FFFFFF"},"label":{"text":"${properties.ASSET_ID}","angle":270,"d":4,"font":{"size":20},"color":"#8E44AD"}}},
                {"legendTitle":"Pump station","component":"vertex","target":"vertex","stylingEnabled":true,"conditions":{"operator":"and","conditions":[{"property":"ASSET_TYPE","operator":"=","value":"PUMP_STATION"}]},"style":{"color":"#2C3E50","size":24,"icon":{"class":"fa-cog","color":"#FFFFFF"},"label":{"text":"${properties.ASSET_ID}","angle":270,"d":4,"font":{"size":20},"color":"#2C3E50"}}},
                {"legendTitle":"Substation","component":"vertex","target":"vertex","stylingEnabled":true,"conditions":{"operator":"and","conditions":[{"property":"ASSET_TYPE","operator":"=","value":"SUBSTATION"}]},"style":{"color":"#8D6E63","size":18,"label":{"text":"${properties.ASSET_ID}","angle":270,"d":4,"font":{"size":20},"color":"#8D6E63"}}},
                {"legendTitle":"Building","component":"vertex","target":"vertex","stylingEnabled":true,"conditions":{"operator":"and","conditions":[{"property":"ASSET_TYPE","operator":"=","value":"BUILDING"}]},"style":{"color":"#7FA65F","size":12,"label":{"text":"${properties.ASSET_ID}","angle":270,"d":4,"font":{"size":20},"color":"#7FA65F"}}},
                {"legendTitle":"Alarm (flashing)","component":"vertex","target":"vertex","stylingEnabled":true,"conditions":{"operator":"and","conditions":[{"property":"HEALTH_STATUS","operator":"=","value":"ALARM"}]},"animations":[[{"duration":1.2,"timingFunction":"ease-in-out","keyFrames":[{"percentage":0,"style":{"opacity":1}},{"percentage":50,"style":{"opacity":0.25}},{"percentage":100,"style":{"opacity":1}}]}]],"style":{"color":"#C74634","label":{"text":"${properties.ASSET_ID}","angle":270,"d":4,"font":{"size":20},"color":"#C74634"}}},
                {"legendTitle":"Warning","component":"vertex","target":"vertex","stylingEnabled":true,"conditions":{"operator":"and","conditions":[{"property":"HEALTH_STATUS","operator":"=","value":"WARNING"}]},"style":{"color":"#F0AB00","label":{"text":"${properties.ASSET_ID}","angle":270,"d":4,"font":{"size":20},"color":"#F0AB00"}}},
                {"legendTitle":"Watch (predicted)","component":"vertex","target":"vertex","stylingEnabled":true,"conditions":{"operator":"and","conditions":[{"property":"HEALTH_STATUS","operator":"=","value":"WATCH"}]},"style":{"color":"#D63384","label":{"text":"${properties.ASSET_ID}","angle":270,"d":4,"font":{"size":20},"color":"#D63384"}}},
                {"legendTitle":"Bypass (closed)","component":"edge","target":"edge","stylingEnabled":true,"conditions":{"operator":"and","conditions":[{"property":"VALVE_STATE","operator":"=","value":"CLOSED"}]},"style":{"color":"#5F96AE"}},
                {"legendTitle":"Anomaly","component":"vertex","target":"vertex","stylingEnabled":true,"conditions":{"operator":"and","conditions":[{"property":"ANOMALY_ID","operator":">","value":0}]},"style":{"color":"#C74634","size":16,"icon":{"class":"fa-exclamation-triangle","color":"#FFFFFF"},"label":{"text":"${properties.ANOMALY_TYPE}","angle":270,"d":4,"font":{"size":20},"color":"#C74634"}}},
                {"legendTitle":"Work order","component":"vertex","target":"vertex","stylingEnabled":true,"conditions":{"operator":"and","conditions":[{"property":"WO_ID","operator":">","value":0}]},"style":{"color":"#16A085","size":16,"icon":{"class":"fa-wrench","color":"#FFFFFF"},"label":{"text":"WO ${properties.WO_ID} ${properties.PRIORITY}","angle":270,"d":4,"font":{"size":20},"color":"#16A085"}}}
                ]
                
                ```
        }

        column ID_A (
            source {
                dataType: CLOB
            }
            layout {
                sequence: 10
            }
        )

        column ID_B (
            source {
                dataType: CLOB
            }
            layout {
                sequence: 30
            }
        )

        column ID_E (
            source {
                dataType: CLOB
            }
            layout {
                sequence: 20
            }
        )

    )

    pageItem P3_ASSET_ID (
        type: selectList
        label {
            label: Asset
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT asset_id || ' ' || name || ' (' || health_status || ')' AS d, asset_id AS r
                FROM   dh_assets
                WHERE  asset_type IN ('PUMP_STATION', 'SUBSTATION')
                ORDER  BY DECODE(health_status, 'ALARM', 1, 'WARNING', 2, 'WATCH', 3, 4), asset_id
                
                ```
        }
        layout {
            sequence: 10
            region: @incident
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P3_BYPASS (
        type: hidden
        layout {
            sequence: 20
            region: @incident
            slot: regionBody
        }
    )

    pageItem P3_OPEN_WO (
        type: hidden
        layout {
            sequence: 30
            region: @incident
            slot: regionBody
        }
    )

    button close-bypass (
        buttonName: CLOSE_BYPASS
        label: Close bypass &P3_BYPASS.
        layout {
            sequence: 40
            region: @incident
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-lock
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: SELECT 1 FROM dh_pipes WHERE pipe_id = :P3_BYPASS AND valve_state = 'OPEN'
        }
    )

    button create-wo (
        buttonName: CREATE_WO
        label: Create work order for &P3_ASSET_ID.
        layout {
            sequence: 50
            region: @incident
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-wrench
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 6
                items: {
                    P6_ASSET_ID: &P3_ASSET_ID.
                }
                clearCache: 6
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: SELECT 1 FROM dh_assets WHERE asset_id = :P3_ASSET_ID AND health_status IN ('ALARM', 'WARNING') AND :P3_OPEN_WO IS NULL
        }
    )

    button open-bypass (
        buttonName: OPEN_BYPASS
        label: Open bypass &P3_BYPASS.
        layout {
            sequence: 30
            region: @incident
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-unlock
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: SELECT 1 FROM dh_pipes WHERE pipe_id = :P3_BYPASS AND valve_state = 'CLOSED'
        }
    )

    button open-wo (
        buttonName: OPEN_WO
        label: Open work order &P3_OPEN_WO.
        layout {
            sequence: 60
            region: @incident
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-wrench
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 6
                items: {
                    P6_WO_ID: &P3_OPEN_WO.
                }
                clearCache: 6
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_OPEN_WO
        }
    )

    computation p3-asset-id (
        itemName: P3_ASSET_ID
        execution {
            sequence: 10
            point: beforeHeader
        }
        computation {
            type: functionBody
            plsqlFunctionBody: "RETURN NVL(JSON_VALUE(agent_find_root_cause(), '$.incidents[0].root_cause_asset'), 'PS-04');"
        }
        serverSideCondition {
            type: itemIsNull
            item: P3_ASSET_ID
        }
    )

    computation p3-bypass (
        itemName: P3_BYPASS
        execution {
            sequence: 20
            point: beforeHeader
        }
        computation {
            type: functionBody
            plsqlFunctionBody: RETURN dh_bypass_for_asset(:P3_ASSET_ID);
        }
    )

    computation p3-open-wo (
        itemName: P3_OPEN_WO
        execution {
            sequence: 30
            point: beforeHeader
        }
        computation {
            sqlQuery: SELECT MAX(wo_id) FROM dh_work_orders WHERE asset_id = :P3_ASSET_ID AND status IN ('NEW', 'PLANNED', 'IN_PROGRESS')
        }
    )

    process close-bypass (
        name: Close bypass
        type: executeCode
        source {
            plsqlCode: dh_set_valve(:P3_BYPASS, 'CLOSED');
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: &P3_BYPASS. is closed.
        }
        error {
            errorMessage: Closing &P3_BYPASS. failed.
        }
        advanced {
            executionMappingIdentifier: 14461061104528175
        }
        serverSideCondition {
            whenButtonPressed: @close-bypass
        }
    )

    process open-bypass (
        name: Open bypass
        type: executeCode
        source {
            plsqlCode: dh_set_valve(:P3_BYPASS, 'OPEN');
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: &P3_BYPASS. is open. The supply returns within about 1.5 minutes.
        }
        error {
            errorMessage: Opening &P3_BYPASS. failed.
        }
        advanced {
            executionMappingIdentifier: 14461177840528175
        }
        serverSideCondition {
            whenButtonPressed: @open-bypass
        }
    )

    branch (
        name: Back to page 3
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 3
            }
        }
    )

)

