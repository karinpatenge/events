# RoOUG / AOUG 2026 - files that must not go into the repository

# SQLcl spool logs (may contain connection details and error output).
# The folder itself stays in the repository (through .gitkeep), its content not.
scripts/logs/*
!scripts/logs/.gitkeep
*.log

# Working material for preparing the session
internal/

# Local configuration with secrets (copy of config.example.toml)
scripts/python/config.toml

# Personal environment and SQLcl session settings
.env
scripts/login.sql

# Generated by scripts/iot/setup_iot.sh: OCIDs of your tenancy
data/twins_*.json
data/twins_*.sql

# Python cache
__pycache__/

# APEXlang export: workspace components with tenancy-specific data (OCI credential, Generative AI service)
scripts/apex/emea-community-tour-2026-from-iot-data-to-intelligent-action/workspace-components/credentials/credentials-for-oci-genai.apx
scripts/apex/emea-community-tour-2026-from-iot-data-to-intelligent-action/workspace-components/generative-ai-services/

# Session documents (demo scripts, setup, structure)
documents/

# Presentation: only the PDF files go into the repository
presentation/*
!presentation/*.pdf

# Media: only the teaser videos and the octemea26 icons go into the repository
media/*
!media/01_teaser*.mp4
!media/octemea26*
