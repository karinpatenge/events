
# Secrets - never commit
.env
.env.*
!.env.example
*.local.sql
*.secret*
.credentials
.par*
*_kp.sql
*Unfallorte*

# 2026/10_HrOUG (HrOUG 2026, Spatial Meets AI): publish only what attendees need to run the demos.
# Everything else in the folder stays local (planning docs, slide graphics, generated data, internal scripts).
/2026/10_HrOUG/*
!/2026/10_HrOUG/scripts/
!/2026/10_HrOUG/data/
!/2026/10_HrOUG/presentations/
/2026/10_HrOUG/scripts/*
# Tram 6 (stops A-D, track)
!/2026/10_HrOUG/scripts/create_table_tram_stations.sql
!/2026/10_HrOUG/scripts/insert_tram_stations.sql
!/2026/10_HrOUG/scripts/create_table_tram_lines.sql
!/2026/10_HrOUG/scripts/insert_tram_lines.sql
# Demo 1: streaming and vector tiles, map, July positions
!/2026/10_HrOUG/scripts/demo1_streaming_vector_tiles.sqlnb
# Demo 2: surface temperature raster, H3 cells, Spatial AI notebooks
!/2026/10_HrOUG/scripts/load_raster_using_gdal.txt
!/2026/10_HrOUG/scripts/demo2_prep_zg_h3_cells.sqlnb
!/2026/10_HrOUG/scripts/demo2_spatial_dependence.dsnb
!/2026/10_HrOUG/scripts/demo2_spatial_heterogeneity.dsnb
!/2026/10_HrOUG/scripts/demo2_spatial_leakage.dsnb
# Demo 3: AI for Spatial
!/2026/10_HrOUG/scripts/create_tool_rank_stops_for_shade.sqlnb
!/2026/10_HrOUG/scripts/run_tool_rank_stops_for_shade.sqlnb
# Planning docs, stories, slide graphics and icons: never publish
# (last rules, so no allow-list entry can re-include them)
/2026/10_HrOUG/documents/
/2026/10_HrOUG/media/
