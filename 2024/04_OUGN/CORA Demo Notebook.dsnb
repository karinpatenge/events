        "hasTitle" : false,
        "message" : [
          "%pgql-pgx",
          "",
          "/* Show types of vertices according to their label */",
          "SELECT label(a), count(a) as cnt ",
          "FROM MATCH (a) ON cora_graph",
          "GROUP BY label(a)",
          "ORDER BY label(a)"
        ],
        "selectedVisualization" : "table",
        "visualizationConfig" : "[{\"table\":{\"lastColumns\":[\"label(a)\",\"CNT\"],\"version\":1}}]",
