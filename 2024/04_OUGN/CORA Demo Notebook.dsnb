          "%md",
          "",
          "## Define the graph",
          "",
          "Build the graph on top of the existing tables without replicating the original data."
        ],
        "selectedVisualization" : "html",
        "visualizationConfig" : null,
        "hideCode" : true,
        "hideResult" : false,
        "hideGutter" : true,
