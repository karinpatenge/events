        "hasTitle" : false,
        "message" : [
          "%python-pgx",
          "",
          "# Import  VertexFilter",
          "from pypgx.api.filters import VertexFilter"
        ],
        "selectedVisualization" : "raw",
        "visualizationConfig" : null,
        "hideCode" : false,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
