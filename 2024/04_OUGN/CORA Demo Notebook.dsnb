          "%pgql-pgx",
          "",
          "/* Show, how the papers with the 5 highest Betweenness values are cited and citing other papers */",
          "SELECT *",
          "FROM MATCH (a) -[c]- (b)  ON cora_graph",
          "WHERE EXISTS (",
          "    SELECT *",
          "    FROM MATCH (a) ON cora_graph",
          "    WHERE a.betweenness > 5000)"
